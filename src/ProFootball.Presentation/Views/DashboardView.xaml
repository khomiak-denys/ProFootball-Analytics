<UserControl x:Class="ProFootball.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProFootball.Presentation.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6,2,6,2">
            <UniformGrid Columns="5" Margin="0,0,0,14">
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Countries}" />
                        <TextBlock Margin="0,26,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Countries}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Leagues}" />
                        <TextBlock Margin="0,26,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Leagues}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Teams}" />
                        <TextBlock Margin="0,26,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Teams}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Players}" />
                        <TextBlock Margin="0,26,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Players}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Matches}" />
                        <TextBlock Margin="0,26,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Matches}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Margin="0,0,0,14" Style="{StaticResource DashboardPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource DashboardSectionTitleStyle}" Text="{loc:Loc Key=Dashboard_QuickFilters_Title}" />
                    <ComboBox Grid.Column="2" Style="{StaticResource QuickFilterComboBoxStyle}" ItemsSource="{Binding Dashboard.SeasonOptions}" SelectedItem="{Binding Dashboard.SelectedSeason, Mode=TwoWay}" />
                    <ComboBox Grid.Column="4" Style="{StaticResource QuickFilterComboBoxStyle}" TextSearch.TextPath="Name" ItemsSource="{Binding Dashboard.LeagueOptions}" SelectedItem="{Binding Dashboard.SelectedLeague, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="6" Content="{loc:Loc Key=Common_Action_Refresh}" Command="{Binding Dashboard.RefreshCommand}" />
                    <TextBlock Grid.Column="8" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}">
                        <Run Text="{loc:Loc Key=Dashboard_AsOf}" />
                        <Run Text="{Binding Dashboard.CurrentDateLabel, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0" Style="{StaticResource DashboardPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="{loc:Loc Key=Dashboard_Trend_Title}" />
                        <Border Height="300" Margin="0,18,0,0" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ItemsControl Grid.Row="0" ItemsSource="{Binding Dashboard.SeasonTrend}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,0" VerticalAlignment="Bottom">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TitleForegroundBrush}"
                                                           FontSize="12"
                                                           Text="{Binding Value, StringFormat={}{0:0.0}}" />
                                                <Border Grid.Row="1"
                                                        Margin="0,6,0,0"
                                                        VerticalAlignment="Bottom"
                                                        Width="28"
                                                        Height="{Binding Value, Converter={StaticResource DashboardValueToHeightConverter}}"
                                                        Background="{DynamicResource SuccessForegroundBrush}"
                                                        CornerRadius="4,4,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Dashboard.SeasonTrend}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{loc:Loc Key=Dashboard_Trend_Legend}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DashboardPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="{loc:Loc Key=Dashboard_Stats_Title}" />
                        <Border Height="300" Margin="0,18,0,0" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <UniformGrid Columns="4" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Dashboard.HomeWins}" />
                                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Stat_HomeWins}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Dashboard.Draws}" />
                                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Stat_Draws}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Dashboard.AwayWins}" />
                                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Stat_AwayWins}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Dashboard.AverageGoalsPerMatchLabel}" />
                                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Stat_AvgGoals}" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource DashboardPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource DashboardSectionTitleStyle}" Text="{loc:Loc Key=Dashboard_RecentMatches_Title}" />
                    <Border MinHeight="120" Margin="0,14,0,0" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid Margin="14,8,14,8">
                            <ItemsControl ItemsSource="{Binding Dashboard.RecentMatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="19" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Date, StringFormat={}{0:dd MMM}}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="21" Foreground="{DynamicResource TitleForegroundBrush}">
                                                <Run Text="{Binding HomeTeamName}" /><Run Text=" vs " /><Run Text="{Binding AwayTeamName}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}">
                                                <Run Text="{Binding HomeTeamGoal, Converter={StaticResource NullableIntTextConverter}}" /><Run Text=" - " /><Run Text="{Binding AwayTeamGoal, Converter={StaticResource NullableIntTextConverter}}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
