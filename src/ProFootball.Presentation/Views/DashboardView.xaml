<UserControl x:Class="ProFootball.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProFootball.Presentation.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dashboard.RecentMatches.Count}" Value="0">
                                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="6,2,6,2">
                                <UniformGrid Columns="5" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Countries}" />
                                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Countries}" />
                                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{loc:Loc Key=Dashboard_Growth_Countries}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="{DynamicResource SuccessSoftBackgroundBrush}" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource SuccessForegroundBrush}" Text="&#xE909;" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Leagues}" />
                                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Leagues}" />
                                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{loc:Loc Key=Dashboard_Growth_Leagues}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="{DynamicResource SuccessSoftBackgroundBrush}" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource SuccessForegroundBrush}" Text="&#xE7BF;" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Teams}" />
                                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Teams}" />
                                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{loc:Loc Key=Dashboard_Growth_Teams}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="{DynamicResource SuccessSoftBackgroundBrush}" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource SuccessForegroundBrush}" Text="&#xE7EF;" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Players}" />
                                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Players}" />
                                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{loc:Loc Key=Dashboard_Growth_Players}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="{DynamicResource SuccessSoftBackgroundBrush}" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource SuccessForegroundBrush}" Text="&#xE77B;" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="{loc:Loc Key=Dashboard_Card_Matches}" />
                                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Matches}" />
                                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{loc:Loc Key=Dashboard_Growth_Matches}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="{DynamicResource SuccessSoftBackgroundBrush}" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource SuccessForegroundBrush}" Text="&#xE8FD;" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <Border Margin="0,0,0,14"
                                        Style="{StaticResource DashboardPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource DashboardSectionTitleStyle}"
                                                   Text="{loc:Loc Key=Dashboard_QuickFilters_Title}" />
                                        <ComboBox Grid.Column="2"
                                                  Style="{StaticResource QuickFilterComboBoxStyle}"
                                                  ItemsSource="{Binding Dashboard.SeasonOptions}"
                                                  SelectedItem="{Binding Dashboard.SelectedSeason, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="4"
                                                  Style="{StaticResource QuickFilterComboBoxStyle}"
                                                  TextSearch.TextPath="Name"
                                                  ItemsSource="{Binding Dashboard.LeagueOptions}"
                                                  SelectedItem="{Binding Dashboard.SelectedLeague, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="6"
                                                Content="{loc:Loc Key=Common_Action_Refresh}"
                                                Command="{Binding Dashboard.RefreshCommand}" />
                                        <TextBlock Grid.Column="8"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource MutedForegroundBrush}">
                                            <Run Text="{loc:Loc Key=Dashboard_AsOf}" />
                                            <Run Text="{Binding Path=Dashboard.CurrentDateLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Margin="0,0,12,0"
                                            Style="{StaticResource DashboardPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}"
                                                       Text="{loc:Loc Key=Dashboard_Trend_Title}" />
                                            <Border Height="300"
                                                    Margin="0,18,0,0"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid Margin="10,10,10,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="640" Height="220">
                                                        <Line X1="40" Y1="20" X2="40" Y2="200" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1.2" />
                                                        <Line X1="40" Y1="200" X2="620" Y2="200" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1.2" />

                                                        <Line X1="40" Y1="150" X2="620" Y2="150" Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="40" Y1="85" X2="620" Y2="85" Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="130" Y1="20" X2="130" Y2="200" Stroke="{DynamicResource SubtleBorderBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="220" Y1="20" X2="220" Y2="200" Stroke="{DynamicResource SubtleBorderBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="310" Y1="20" X2="310" Y2="200" Stroke="{DynamicResource SubtleBorderBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="400" Y1="20" X2="400" Y2="200" Stroke="{DynamicResource SubtleBorderBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="490" Y1="20" X2="490" Y2="200" Stroke="{DynamicResource SubtleBorderBrush}" StrokeThickness="1" StrokeDashArray="2,2" />

                                                        <Polyline Points="40,155 130,120 220,132 310,98 490,56 620,64"
                                                                  Stroke="{DynamicResource SuccessForegroundBrush}"
                                                                  StrokeThickness="2.4" />

                                                        <Ellipse Width="8" Height="8" Canvas.Left="36" Canvas.Top="151" Fill="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="126" Canvas.Top="116" Fill="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="216" Canvas.Top="128" Fill="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="306" Canvas.Top="94" Fill="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="486" Canvas.Top="52" Fill="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="616" Canvas.Top="60" Fill="{DynamicResource CardBackgroundBrush}" Stroke="{DynamicResource SuccessForegroundBrush}" StrokeThickness="2" />

                                                        <TextBlock Canvas.Left="12" Canvas.Top="193" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="75" />
                                                        <TextBlock Canvas.Left="12" Canvas.Top="142" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="77" />
                                                        <TextBlock Canvas.Left="12" Canvas.Top="76" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="80" />
                                                    </Canvas>
                                                    </Viewbox>

                                                    <UniformGrid Grid.Row="1" Columns="6" Margin="44,-4,10,0">
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Month_Jan}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Month_Feb}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Month_Mar}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Month_Apr}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Month_May}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Month_Jun}" />
                                                    </UniformGrid>

                                                    <TextBlock Grid.Row="2"
                                                               Margin="0,8,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontSize="19"
                                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                                       Text="{loc:Loc Key=Dashboard_Trend_Legend}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource DashboardPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}"
                                                       Text="{loc:Loc Key=Dashboard_Stats_Title}" />
                                            <Border Height="300"
                                                    Margin="0,18,0,0"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid Margin="10,10,10,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="640" Height="220">
                                                        <Line X1="40" Y1="20" X2="40" Y2="200" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1.2" />
                                                        <Line X1="40" Y1="200" X2="620" Y2="200" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1.2" />

                                                        <Line X1="40" Y1="128" X2="620" Y2="128" Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="40" Y1="86" X2="620" Y2="86" Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="40" Y1="44" X2="620" Y2="44" Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,2" />

                                                        <Rectangle Width="100" Height="4" Canvas.Left="55" Canvas.Top="196" Fill="{DynamicResource SuccessForegroundBrush}" />
                                                        <Rectangle Width="100" Height="3" Canvas.Left="195" Canvas.Top="197" Fill="{DynamicResource SuccessForegroundBrush}" />
                                                        <Rectangle Width="100" Height="26" Canvas.Left="335" Canvas.Top="174" Fill="{DynamicResource SuccessForegroundBrush}" />
                                                        <Rectangle Width="100" Height="150" Canvas.Left="475" Canvas.Top="50" Fill="{DynamicResource SuccessForegroundBrush}" />

                                                        <TextBlock Canvas.Left="8" Canvas.Top="193" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="0" />
                                                        <TextBlock Canvas.Left="10" Canvas.Top="120" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="40" />
                                                        <TextBlock Canvas.Left="10" Canvas.Top="78" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="80" />
                                                        <TextBlock Canvas.Left="2" Canvas.Top="36" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="120" />
                                                        <TextBlock Canvas.Left="2" Canvas.Top="10" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="160" />
                                                    </Canvas>
                                                    </Viewbox>
                                                    <UniformGrid Grid.Row="1" Columns="4" Margin="42,-4,10,0">
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Stat_Goals}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Stat_Assists}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Stat_Shots}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Dashboard_Stat_Passes}" />
                                                    </UniformGrid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource DashboardPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DashboardSectionTitleStyle}"
                                                   Text="{loc:Loc Key=Dashboard_RecentMatches_Title}" />
                                        <Border MinHeight="120"
                                                Margin="0,14,0,0"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid Margin="14,8,14,8">
                                                <ItemsControl ItemsSource="{Binding Dashboard.RecentMatches}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="110" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="19"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                                           Text="{Binding Date, StringFormat={}{0:dd MMM}}" />
                                                                <TextBlock Grid.Column="1"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,0,0"
                                                                           FontSize="21"
                                                                           Foreground="{DynamicResource TitleForegroundBrush}">
                                                                    <Run Text="{Binding Path=HomeTeamName, Mode=OneWay}" />
                                                                    <Run Text=" vs " />
                                                                    <Run Text="{Binding Path=AwayTeamName, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="2"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="21"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource SuccessForegroundBrush}">
                                                                    <Run Text="{Binding Path=HomeTeamGoal, Mode=OneWay, Converter={StaticResource NullableIntTextConverter}}" />
                                                                    <Run Text=" - " />
                                                                    <Run Text="{Binding Path=AwayTeamGoal, Mode=OneWay, Converter={StaticResource NullableIntTextConverter}}" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           Text="{loc:Loc Key=Dashboard_RecentMatches_Empty}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Dashboard.RecentMatches.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    
</UserControl>


