<UserControl x:Class="ProFootball.Presentation.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
                        <Grid Margin="6,2,6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Padding="16"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="36"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="Filters" />
                                    <TextBlock Margin="0,26,0,0"
                                                                                             FontSize="26"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="Player Name" />
                                    <TextBox Margin="0,8,0,0"
                                                                                         Style="{StaticResource PlayersFilterTextBoxStyle}"
                                             Text="{Binding Players.NameFilter, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Margin="0,22,0,0"
                                                                                             FontSize="26"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="Overall Rating" />
                                    <ComboBox Margin="0,8,0,0"
                                                                                            Style="{StaticResource PlayersFilterComboBoxStyle}"
                                              ItemsSource="{Binding Players.OverallRatingOptions}"
                                              SelectedItem="{Binding Players.SelectedOverallRatingOption, Mode=TwoWay}" />

                                    <TextBlock Margin="0,22,0,0"
                                                                                             FontSize="26"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="Preferred Foot" />
                                    <ComboBox Margin="0,8,0,0"
                                                                                            Style="{StaticResource PlayersFilterComboBoxStyle}"
                                              ItemsSource="{Binding Players.PreferredFootOptions}"
                                              SelectedItem="{Binding Players.SelectedPreferredFootOption, Mode=TwoWay}" />
                                    <TextBlock Margin="0,12,0,0"
                                               FontSize="16"
                                               Foreground="{DynamicResource DangerForegroundBrush}"
                                               Text="{Binding Players.ErrorMessage}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="16"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Text="{Binding Players.IsLoadingList, StringFormat=Loading: {0}}" />
                                    <TextBlock Margin="0,20,0,0"
                                               FontSize="28"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Text="{Binding Players.TotalCount, StringFormat=Total: {0} players}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="0,0,16,0"
                                    Padding="16"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="36"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="Players List" />
                                    <DataGrid Grid.Row="1"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding Players.Players}"
                                              SelectedItem="{Binding Players.SelectedPlayer, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              RowHeaderWidth="0"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              GridLinesVisibility="Horizontal"
                                              IsReadOnly="True">
                                        <DataGrid.RowStyle>
                                            <StaticResource ResourceKey="PlayersTableRowStyle" />
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="65" />
                                            <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="52" />
                                            <DataGridTextColumn Header="Rating" Binding="{Binding OverallRating}" Width="58" />
                                            <DataGridTextColumn Header="Potential" Binding="{Binding Potential}" Width="72" />
                                            <DataGridTextColumn Header="Foot" Binding="{Binding PreferredFoot}" Width="58" />
                                            <DataGridTextColumn Header="Height" Binding="{Binding HeightDisplay}" Width="72" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="16"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock FontSize="36"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   Text="Player Details" />
                                        <TextBlock Margin="0,18,0,0"
                                                   FontSize="48"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   Text="{Binding Players.DetailsPlayerName}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="30"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Text="{Binding Players.DetailsPosition}" />
                                        <Grid Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock FontSize="22" Foreground="{DynamicResource MutedForegroundBrush}" Text="Overall" />
                                            <TextBlock Grid.Column="1" FontSize="22" Foreground="{DynamicResource MutedForegroundBrush}" Text="Potential" />
                                            <TextBlock Grid.Row="1" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Players.DetailsOverall}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Players.DetailsPotential}" />
                                            <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="22" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Players.DetailsAge, StringFormat=Age: {0}}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" FontSize="22" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Players.DetailsFoot, StringFormat=Foot: {0}}" />
                                            <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="22" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Players.DetailsHeight, StringFormat=Height: {0}}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" FontSize="22" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Players.DetailsWeight, StringFormat=Weight: {0}}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2"
                                        Padding="16"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Height="44"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding Players.ShowOverviewCommand}"
                                                    FontSize="22"
                                                    Content="Overview">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="10">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Players.IsOverviewSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Height="44"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding Players.ShowHistoryCommand}"
                                                    FontSize="22"
                                                    Content="History">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource SelectionSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="10">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Players.IsHistorySelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Players.IsOverviewSelected}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Canvas Height="320">
                                                <Polygon Stroke="{DynamicResource ChartGridBrush}"
                                                         StrokeThickness="1"
                                                         Fill="Transparent"
                                                         Points="132,44 225,98 225,206 132,260 38,206 38,98" />
                                                <Polygon Stroke="{DynamicResource ChartGridBrush}"
                                                         StrokeThickness="1"
                                                         Fill="Transparent"
                                                         Points="132,71 202,111 202,193 132,233 61,193 61,111" />
                                                <Polygon Stroke="{DynamicResource ChartGridBrush}"
                                                         StrokeThickness="1"
                                                         Fill="Transparent"
                                                         Points="132,98 179,125 179,179 132,206 84,179 84,125" />
                                                <Polygon Stroke="{DynamicResource ChartGridBrush}"
                                                         StrokeThickness="1"
                                                         Fill="Transparent"
                                                         Points="132,125 156,138 156,165 132,179 107,165 107,138" />
                                                <Line X1="132" Y1="44" X2="132" Y2="260" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1" />
                                                <Line X1="38" Y1="98" X2="225" Y2="206" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1" />
                                                <Line X1="225" Y1="98" X2="38" Y2="206" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1" />
                                                <Polygon Stroke="{DynamicResource SuccessForegroundBrush}"
                                                         StrokeThickness="2"
                                                         Fill="{DynamicResource RadarFillBrush}"
                                                         Points="{Binding Players.RadarPolygonPoints}" />

                                                <TextBlock Canvas.Left="126" Canvas.Top="12" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Pace" />
                                                <TextBlock Canvas.Left="272" Canvas.Top="86" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Shooting" />
                                                <TextBlock Canvas.Left="262" Canvas.Top="198" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Passing" />
                                                <TextBlock Canvas.Left="124" Canvas.Top="286" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Dribbling" />
                                                <TextBlock Canvas.Left="8" Canvas.Top="198" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Defending" />
                                                <TextBlock Canvas.Left="0" Canvas.Top="86" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Physical" />
                                            </Canvas>
                                        </Grid>
                                        <Border Margin="0,16,0,0"
                                                Padding="8"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Players.IsOverviewSelected}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="220" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Canvas Width="334" Height="220" HorizontalAlignment="Center">
                                                    <Line X1="26" Y1="16" X2="26" Y2="196" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1" />
                                                    <Line X1="26" Y1="196" X2="320" Y2="196" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1" />

                                                    <Line X1="26" Y1="142" X2="320" Y2="142" Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                    <Line X1="26" Y1="96" X2="320" Y2="96" Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                    <Line X1="26" Y1="50" X2="320" Y2="50" Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2,2" />

                                                    <Polyline Points="{Binding Players.SelectedPlayerTrendPoints, Converter={StaticResource TrendToPointsConverter}, ConverterParameter=overall}"
                                                              Stroke="{DynamicResource SuccessForegroundBrush}"
                                                              StrokeThickness="2.2">
                                                        <Polyline.RenderTransform>
                                                            <TranslateTransform X="16" Y="28" />
                                                        </Polyline.RenderTransform>
                                                    </Polyline>
                                                    <Polyline Points="{Binding Players.SelectedPlayerTrendPoints, Converter={StaticResource TrendToPointsConverter}, ConverterParameter=potential}"
                                                              Stroke="{DynamicResource BlueAccentBrush}"
                                                              StrokeThickness="2.2">
                                                        <Polyline.RenderTransform>
                                                            <TranslateTransform X="16" Y="28" />
                                                        </Polyline.RenderTransform>
                                                    </Polyline>

                                                    <TextBlock Canvas.Left="2" Canvas.Top="188" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="80" />
                                                    <TextBlock Canvas.Left="2" Canvas.Top="134" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="84" />
                                                    <TextBlock Canvas.Left="2" Canvas.Top="88" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="88" />
                                                    <TextBlock Canvas.Left="2" Canvas.Top="42" FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="95" />
                                                </Canvas>

                                                <ItemsControl Grid.Row="1"
                                                              Margin="26,4,14,0"
                                                              ItemsSource="{Binding Players.SelectedPlayerTrendPoints}"
                                                              ItemTemplate="{StaticResource PlayersTrendPointDateTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>

                                                <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontSize="14" Foreground="{DynamicResource SuccessForegroundBrush}" Text="- Overall" />
                                                    <TextBlock Margin="10,0,0,0" FontSize="14" Foreground="{DynamicResource BlueAccentBrush}" Text="- Potential" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    
</UserControl>
