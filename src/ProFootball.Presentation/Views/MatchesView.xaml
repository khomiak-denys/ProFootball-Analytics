<UserControl x:Class="ProFootball.Presentation.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ProFootball.Presentation.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
    <Grid Margin="8,4,8,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filters_Title}" />

                <TextBlock Margin="0,16,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_League}" />
                <ComboBox Margin="0,8,0,0"
                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                          TextSearch.TextPath="Name"
                          ItemsSource="{Binding Matches.Leagues}"
                          SelectedItem="{Binding Matches.SelectedLeague, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_Season}" />
                <ComboBox Margin="0,8,0,0"
                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                          ItemsSource="{Binding Matches.SeasonOptions}"
                          SelectedItem="{Binding Matches.Season, Mode=TwoWay}" />

                <TextBlock Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_Team}" />
                <ComboBox Margin="0,8,0,0"
                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                          TextSearch.TextPath="Name"
                          ItemsSource="{Binding Matches.TeamOptions}"
                          SelectedItem="{Binding Matches.SelectedTeamOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_DateFrom}" />
                <DatePicker Margin="0,8,0,0"
                            Style="{StaticResource MatchesFilterDatePickerStyle}"
                            SelectedDate="{Binding Matches.DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_DateTo}" />
                <DatePicker Margin="0,8,0,0"
                            Style="{StaticResource MatchesFilterDatePickerStyle}"
                            SelectedDate="{Binding Matches.DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border Margin="0,16,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource MutedForegroundBrush}">
                            <Run Text="{loc:Loc Key=Matches_Info_Total}" />
                            <Run Text="{Binding Path=Matches.TotalCount, Mode=OneWay}" />
                            <Run Text="{loc:Loc Key=Matches_Info_MatchesSuffix}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Width="96" Margin="0,0,8,0" Content="{loc:Loc Key=Common_Action_Prev}" Command="{Binding Matches.PreviousPageCommand}" />
                    <Button Width="96" Content="{loc:Loc Key=Common_Action_Next}" Command="{Binding Matches.NextPageCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_List_Title}" />
                        <Button Grid.Column="1"
                                Width="42"
                                Height="42"
                                Margin="10,0,0,0"
                                Background="{DynamicResource SuccessForegroundBrush}"
                                Foreground="White"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Content="&#xE710;"
                                ToolTip="{loc:Loc Key=Matches_Add_Button}"
                                Command="{Binding Matches.OpenAddMatchModalCommand}" />
                        <Button Grid.Column="2"
                                Width="42"
                                Height="42"
                                Margin="10,0,0,0"
                                Background="{DynamicResource SelectionSurfaceBrush}"
                                Foreground="{DynamicResource TitleForegroundBrush}"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Content="&#xE70F;"
                                ToolTip="{loc:Loc Key=Matches_Edit_Button}"
                                Command="{Binding Matches.OpenEditMatchModalCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CanManageData}" Value="True" />
                                                <Condition Binding="{Binding Matches.HasSelectedMatch}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Text="{loc:Loc Key=Matches_List_Subtitle}" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <DataGrid ItemsSource="{Binding Matches.Matches}"
                              SelectedItem="{Binding Matches.SelectedMatch, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              CellStyle="{StaticResource MatchesTableCellStyle}"
                              RowStyle="{StaticResource MatchesTableRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_Date}" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="1.1*" MinWidth="110" />
                            <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_Country}" Binding="{Binding CountryName}" Width="1.2*" MinWidth="120" />
                            <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_League}" Binding="{Binding LeagueName}" Width="2.0*" MinWidth="180" />
                            <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_Season}" Binding="{Binding Season}" Width="1.1*" MinWidth="110" />
                            <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_HomeTeam}" Binding="{Binding HomeTeamName}" Width="1.8*" MinWidth="170" />
                            <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_AwayTeam}" Binding="{Binding AwayTeamName}" Width="1.8*" MinWidth="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.ColumnSpan="3"
              Panel.ZIndex="1000"
              Background="#99000000"
              Visibility="{Binding Matches.IsAddMatchModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="560"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="36"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleForegroundBrush}"
                                       Text="{loc:Loc Key=Matches_Add_Title}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="18"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{loc:Loc Key=Matches_Add_Subtitle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                Content="&#xE711;"
                                Command="{Binding Matches.CloseAddMatchModalCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Add_Country}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource AuthInputTextBoxStyle}"
                                 Text="{Binding Matches.NewMatchCountryName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Add_Season}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource AuthInputTextBoxStyle}"
                                 Text="{Binding Matches.NewMatchSeason, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Add_LeagueId}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource AuthInputTextBoxStyle}"
                                 Text="{Binding Matches.NewMatchLeagueId, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Add_Date}" />
                        <DatePicker Margin="0,8,0,0"
                                    Style="{StaticResource MatchesFilterDatePickerStyle}"
                                    SelectedDate="{Binding Matches.NewMatchDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Add_HomeTeamId}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource AuthInputTextBoxStyle}"
                                 Text="{Binding Matches.NewMatchHomeTeamId, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Add_AwayTeamId}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource AuthInputTextBoxStyle}"
                                 Text="{Binding Matches.NewMatchAwayTeamId, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Add_HomeGoals}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource AuthInputTextBoxStyle}"
                                 Text="{Binding Matches.NewMatchHomeGoals, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Add_AwayGoals}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource AuthInputTextBoxStyle}"
                                 Text="{Binding Matches.NewMatchAwayGoals, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,20,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Width="150"
                                Margin="0,0,10,0"
                                Content="{loc:Loc Key=Common_Action_Cancel}"
                                Command="{Binding Matches.CloseAddMatchModalCommand}" />
                        <Button Width="190"
                                Background="{DynamicResource SuccessForegroundBrush}"
                                Foreground="White"
                                Content="{loc:Loc Key=Matches_Add_Confirm}"
                                Command="{Binding Matches.AddMatchCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="3"
              Panel.ZIndex="1001"
              Background="#99000000"
              Visibility="{Binding Matches.IsEditMatchModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="560"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="36"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleForegroundBrush}"
                                       Text="{loc:Loc Key=Matches_Edit_Title}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="18"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{loc:Loc Key=Matches_Edit_Subtitle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                Content="&#xE711;"
                                Command="{Binding Matches.CloseEditMatchModalCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{loc:Loc Key=Matches_Add_Country}" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource AuthInputTextBoxStyle}" Text="{Binding Matches.EditorCountryName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{loc:Loc Key=Matches_Add_Season}" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource AuthInputTextBoxStyle}" Text="{Binding Matches.EditorSeason, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{loc:Loc Key=Matches_Add_LeagueId}" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource AuthInputTextBoxStyle}" Text="{Binding Matches.EditorLeagueId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{loc:Loc Key=Matches_Add_HomeTeamId}" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource AuthInputTextBoxStyle}" Text="{Binding Matches.EditorHomeTeamId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{loc:Loc Key=Matches_Add_AwayTeamId}" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource AuthInputTextBoxStyle}" Text="{Binding Matches.EditorAwayTeamId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{loc:Loc Key=Matches_Add_HomeGoals}" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource AuthInputTextBoxStyle}" Text="{Binding Matches.EditorHomeGoals, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{loc:Loc Key=Matches_Add_AwayGoals}" />
                        <TextBox Margin="0,8,0,0" Style="{StaticResource AuthInputTextBoxStyle}" Text="{Binding Matches.EditorAwayGoals, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="150" Margin="0,0,10,0" Content="{loc:Loc Key=Common_Action_Cancel}" Command="{Binding Matches.CloseEditMatchModalCommand}" />
                        <Button Width="190" Background="{DynamicResource SuccessForegroundBrush}" Foreground="White" Content="{loc:Loc Key=Matches_Edit_Confirm}" Command="{Binding Matches.SaveEditMatchCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


