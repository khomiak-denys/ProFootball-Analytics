<UserControl x:Class="ProFootball.Presentation.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
                        <Grid Margin="6,2,6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="36"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="Filters" />

                                    <TextBlock Margin="0,22,0,0" FontSize="26" Foreground="{DynamicResource TitleForegroundBrush}" Text="League" />
                                    <ComboBox Margin="0,8,0,0"
                                              Style="{StaticResource PlayersFilterComboBoxStyle}"
                                              ItemsSource="{Binding Matches.Leagues}"
                                              SelectedItem="{Binding Matches.SelectedLeague, Mode=TwoWay}"
                                              DisplayMemberPath="Name" />

                                    <TextBlock Margin="0,18,0,0" FontSize="26" Foreground="{DynamicResource TitleForegroundBrush}" Text="Season" />
                                    <TextBox Margin="0,8,0,0"
                                             Style="{StaticResource PlayersFilterTextBoxStyle}"
                                             Text="{Binding Matches.Season, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Margin="0,18,0,0" FontSize="26" Foreground="{DynamicResource TitleForegroundBrush}" Text="Team API" />
                                    <TextBox Margin="0,8,0,0"
                                             Style="{StaticResource PlayersFilterTextBoxStyle}"
                                             Text="{Binding Matches.TeamApiId, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                                        <Button Width="104" Margin="0,0,10,0" Content="Load" Command="{Binding Matches.LoadLeaguesCommand}" />
                                        <Button Width="104" Margin="0,0,10,0" Content="Search" Command="{Binding Matches.SearchCommand}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Button Width="104" Margin="0,0,10,0" Content="Prev" Command="{Binding Matches.PreviousPageCommand}" />
                                        <Button Width="104" Content="Next" Command="{Binding Matches.NextPageCommand}" />
                                    </StackPanel>

                                    <Button Margin="0,16,0,0"
                                            Content="Open Details"
                                            Command="{Binding Matches.OpenDetailsCommand}" />

                                    <TextBlock Margin="0,16,0,0"
                                               FontSize="16"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Text="{Binding Matches.TotalCount, StringFormat=Total: {0} matches}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SectionPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="36"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="Matches List" />
                                    <DataGrid Grid.Row="1"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding Matches.Matches}"
                                              SelectedItem="{Binding Matches.SelectedMatch, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              RowHeaderWidth="0"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              GridLinesVisibility="Horizontal"
                                              IsReadOnly="True"
                                              RowStyle="{StaticResource MatchesTableRowStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="120" />
                                            <DataGridTextColumn Header="League" Binding="{Binding LeagueName}" Width="*" />
                                            <DataGridTextColumn Header="Home" Binding="{Binding HomeTeamName}" Width="170" />
                                            <DataGridTextColumn Header="Score" Width="76">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="{}{0} - {1}">
                                                        <Binding Path="HomeTeamGoal" />
                                                        <Binding Path="AwayTeamGoal" />
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Away" Binding="{Binding AwayTeamName}" Width="170" />
                                            <DataGridTextColumn Header="Stage" Binding="{Binding MatchApiId}" Width="72" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="30"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   Text="Match Details" />
                                        <StackPanel Margin="0,16,0,0">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Competition" />
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchCompetition}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Country" />
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchCountry}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Season" />
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchSeason}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Stage" />
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchStage}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Date" />
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchDate}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="30"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   Text="Final Score" />
                                        <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Home" />
                                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchHomeTeam}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Matches.SelectedMatchScore}" />
                                            </Grid>
                                        </Border>
                                        <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="Away" />
                                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchAwayTeam}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="4" Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="30"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   Text="Match Statistics" />
                                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Matches.MatchStatistics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                   Text="{Binding Label}" />
                                                        <Border Grid.Column="1"
                                                                Height="14"
                                                                Margin="10,0,10,0"
                                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                                CornerRadius="7">
                                                            <Border Width="{Binding BarWidth}"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{DynamicResource SuccessForegroundBrush}"
                                                                    CornerRadius="7" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                                   Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    
</UserControl>