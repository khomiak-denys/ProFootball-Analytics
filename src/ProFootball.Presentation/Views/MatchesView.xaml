<UserControl x:Class="ProFootball.Presentation.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ProFootball.Presentation.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
    <Grid Margin="8,4,8,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filters_Title}" />

                <TextBlock Margin="0,16,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_League}" />
                <ComboBox Margin="0,8,0,0"
                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                          TextSearch.TextPath="Name"
                          ItemsSource="{Binding Matches.Leagues}"
                          SelectedItem="{Binding Matches.SelectedLeague, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_Season}" />
                <ComboBox Margin="0,8,0,0"
                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                          ItemsSource="{Binding Matches.SeasonOptions}"
                          SelectedItem="{Binding Matches.Season, Mode=TwoWay}" />

                <TextBlock Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_Team}" />
                <ComboBox Margin="0,8,0,0"
                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                          TextSearch.TextPath="Name"
                          ItemsSource="{Binding Matches.TeamOptions}"
                          SelectedItem="{Binding Matches.SelectedTeamOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_DateFrom}" />
                <DatePicker Margin="0,8,0,0"
                            Style="{StaticResource MatchesFilterDatePickerStyle}"
                            SelectedDate="{Binding Matches.DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,14,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           Text="{loc:Loc Key=Matches_Filter_DateTo}" />
                <DatePicker Margin="0,8,0,0"
                            Style="{StaticResource MatchesFilterDatePickerStyle}"
                            SelectedDate="{Binding Matches.DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border Margin="0,16,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanManageData}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{loc:Loc Key=Matches_Write_Title}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource PlayersFilterTextBoxStyle}"
                                 Text="{Binding Matches.EditorCountryName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource PlayersFilterTextBoxStyle}"
                                 Text="{Binding Matches.EditorSeason, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource PlayersFilterTextBoxStyle}"
                                 Text="{Binding Matches.EditorLeagueId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource PlayersFilterTextBoxStyle}"
                                 Text="{Binding Matches.EditorHomeTeamId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,8,0,0"
                                 Style="{StaticResource PlayersFilterTextBoxStyle}"
                                 Text="{Binding Matches.EditorAwayTeamId, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Width="70" Margin="0,0,8,0" Content="{loc:Loc Key=Common_Action_Create}" Command="{Binding Matches.CreateMatchCommand}" />
                            <Button Width="70" Margin="0,0,8,0" Content="{loc:Loc Key=Common_Action_Update}" Command="{Binding Matches.UpdateMatchCommand}" />
                            <Button Width="70" Content="{loc:Loc Key=Common_Action_Delete}" Command="{Binding Matches.DeleteMatchCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource MutedForegroundBrush}">
                            <Run Text="{loc:Loc Key=Matches_Info_Total}" />
                            <Run Text="{Binding Path=Matches.TotalCount, Mode=OneWay}" />
                            <Run Text="{loc:Loc Key=Matches_Info_MatchesSuffix}" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedForegroundBrush}">
                            <Run Text="{loc:Loc Key=Matches_Info_HasNextPage}" />
                            <Run Text="{Binding Path=Matches.HasNextPage, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource DangerForegroundBrush}">
                            <Run Text="{loc:Loc Key=Matches_Info_SelectedDate}" />
                            <Run Text="{Binding Path=Matches.SelectedMatchDate, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Width="96" Margin="0,0,8,0" Content="{loc:Loc Key=Common_Action_Prev}" Command="{Binding Matches.PreviousPageCommand}" />
                    <Button Width="96" Content="{loc:Loc Key=Common_Action_Next}" Command="{Binding Matches.NextPageCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Padding="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Text="{loc:Loc Key=Matches_List_Title}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Text="{loc:Loc Key=Matches_List_Subtitle}" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Matches.Matches}"
                                  SelectedItem="{Binding Matches.SelectedMatch, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  RowHeaderWidth="0"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  CellStyle="{StaticResource MatchesTableCellStyle}"
                                  RowStyle="{StaticResource MatchesTableRowStyle}">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Matches.HasSelectedMatch}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_Date}" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="120" />
                                <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_League}" Binding="{Binding LeagueName}" Width="220" />
                                <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_HomeTeam}" Binding="{Binding HomeTeamName}" Width="220" />
                                <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_AwayTeam}" Binding="{Binding AwayTeamName}" Width="220" />
                                <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_Stage}" Binding="{Binding MatchApiId}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding Matches.Matches}"
                                  SelectedItem="{Binding Matches.SelectedMatch, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  RowHeaderWidth="0"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  CellStyle="{StaticResource MatchesTableCellStyle}"
                                  RowStyle="{StaticResource MatchesTableRowStyle}">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Matches.HasSelectedMatch}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_Date}" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="120" />
                                <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_HomeTeam}" Binding="{Binding HomeTeamName}" Width="260" />
                                <DataGridTextColumn Header="{loc:Loc Key=Matches_Column_AwayTeam}" Binding="{Binding AwayTeamName}" Width="260" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="4">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Matches.HasSelectedMatch}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Text="{loc:Loc Key=Matches_Details_Title}" />

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Matches_Details_Competition}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchCompetition}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Matches_Details_Country}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchCountry}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Matches_Details_Season}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchSeason}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Matches_Details_Stage}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchStage}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Matches_Details_Date}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchDate}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Text="{loc:Loc Key=Matches_Score_Title}" />

                    <Border Margin="0,14,0,0"
                            Padding="12"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Matches_Score_Home}" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchHomeTeam}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}"
                                       Text="{Binding Matches.SelectedMatchHomeScore}" />
                        </Grid>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Matches_Score_Away}" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" Text="{Binding Matches.SelectedMatchAwayTeam}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessForegroundBrush}"
                                       Text="{Binding Matches.SelectedMatchAwayScore}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Text="{loc:Loc Key=Matches_Statistics_Title}" />

                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Matches.MatchStatistics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock FontSize="13"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="{Binding Value}" />

                                    <Grid Grid.Row="1"
                                          Grid.ColumnSpan="2"
                                          Margin="0,7,0,0">
                                        <Border Height="8"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                CornerRadius="4" />
                                        <Border Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"
                                                Height="8"
                                                Background="#22c55e"
                                                CornerRadius="4" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


