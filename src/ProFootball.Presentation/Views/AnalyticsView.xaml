<UserControl x:Class="ProFootball.Presentation.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ProFootball.Presentation.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,2,6,2"
                                        TextElement.Foreground="{DynamicResource TitleForegroundBrush}">
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="30" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_Comparison_Title}" />
                                            <Button Grid.Column="1" Width="120" Height="34" Content="{loc:Loc Key=Common_Action_Refresh}" Command="{Binding Analytics.RefreshAllCommand}" />
                                        </Grid>
                                        <Border Margin="0,12,0,0" Padding="4" Background="{DynamicResource SegmentBackgroundBrush}" CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Analytics.IsComparePlayersMode}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SegmentSelectedBackgroundBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Button BorderThickness="0"
                                                            Background="Transparent"
                                                            FontSize="20"
                                                            FontWeight="SemiBold"
                                                            Content="{loc:Loc Key=Analytics_Mode_ComparePlayers}"
                                                            Command="{Binding Analytics.ComparePlayersModeCommand}" />
                                                </Border>
                                                <Border Grid.Column="1" CornerRadius="9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Analytics.IsCompareTeamsMode}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SegmentSelectedBackgroundBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Button BorderThickness="0"
                                                            Background="Transparent"
                                                            FontSize="20"
                                                            FontWeight="SemiBold"
                                                            Content="{loc:Loc Key=Analytics_Mode_CompareTeams}"
                                                            Command="{Binding Analytics.CompareTeamsModeCommand}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding Analytics.IsComparePlayersMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="18" Text="{loc:Loc Key=Analytics_Filter_Player1}" />
                                                <ComboBox Margin="0,6,0,0"
                                                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                                                          ItemsSource="{Binding Analytics.AvailablePlayers}"
                                                          SelectedItem="{Binding Analytics.SelectedPlayer1, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontSize="18" Text="{loc:Loc Key=Analytics_Filter_Player2}" />
                                                <ComboBox Margin="0,6,0,0"
                                                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                                                          ItemsSource="{Binding Analytics.AvailablePlayers}"
                                                          SelectedItem="{Binding Analytics.SelectedPlayer2, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock FontSize="18" Text="{loc:Loc Key=Analytics_Filter_Metric}" />
                                                <ComboBox Margin="0,6,0,0"
                                                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                                                          ItemsSource="{Binding Analytics.MetricOptions}"
                                                          SelectedItem="{Binding Analytics.SelectedMetric, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding Analytics.IsCompareTeamsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="18" Text="{loc:Loc Key=Analytics_Filter_Team1}" />
                                                <ComboBox Margin="0,6,0,0"
                                                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                                                          ItemsSource="{Binding Analytics.AvailableTeams}"
                                                          SelectedItem="{Binding Analytics.SelectedTeam1, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontSize="18" Text="{loc:Loc Key=Analytics_Filter_Team2}" />
                                                <ComboBox Margin="0,6,0,0"
                                                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                                                          ItemsSource="{Binding Analytics.AvailableTeams}"
                                                          SelectedItem="{Binding Analytics.SelectedTeam2, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock FontSize="18" Text="{loc:Loc Key=Analytics_Filter_Metric}" />
                                                <ComboBox Margin="0,6,0,0"
                                                          Style="{StaticResource PlayersFilterComboBoxStyle}"
                                                          ItemsSource="{Binding Analytics.TeamMetricOptions}"
                                                          SelectedItem="{Binding Analytics.SelectedTeamMetric, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0" FontSize="16" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding Analytics.ErrorMessage}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,14,0,0"
                                            Visibility="{Binding Analytics.IsCompareTeamsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Analytics.SelectedTeamOneName}" />
                                                <TextBlock Margin="0,8,0,0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.SelectedTeamOneMetricValue, StringFormat={}{0:0.0}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Analytics.SelectedTeamTwoName}" />
                                                <TextBlock Margin="0,8,0,0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.SelectedTeamTwoMetricValue, StringFormat={}{0:0.0}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Analytics_Card_AverageValue}" />
                                                <TextBlock Margin="0,8,0,0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.AverageOverallRating, StringFormat={}{0:0.0}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionPanelStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Analytics_Card_AbsoluteGap}" />
                                                <TextBlock Margin="0,8,0,0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource BlueAccentBrush}" Text="{Binding Analytics.AveragePotential, StringFormat={}{0:0.0}}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <Border Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_TeamsSummary_Title}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Text="{Binding Analytics.TeamsModeSummary}" />
                                            <ItemsControl Margin="0,14,0,0"
                                                          ItemsSource="{Binding Analytics.TopPerformerBars}"
                                                          ItemTemplate="{StaticResource AnalyticsTopPerformerBarTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Margin="0,14,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Analytics.IsComparePlayersMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Analytics_Card_AvgOverall}" />
                                                <TextBlock Margin="0,10,0,0" FontSize="38" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.AverageOverallRating, StringFormat={}{0:0.0}}" />
                                                <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.AverageOverallDelta}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Analytics_Card_AvgPotential}" />
                                                <TextBlock Margin="0,10,0,0" FontSize="38" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.AveragePotential, StringFormat={}{0:0.0}}" />
                                                <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.AveragePotentialDelta}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Analytics_Card_TopPerformers}" />
                                                <TextBlock Margin="0,10,0,0" FontSize="38" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.TopPerformersCount}" />
                                                <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Analytics_Card_TopPerformersHint}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SectionPanelStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="18" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Analytics_Card_RisingStars}" />
                                                <TextBlock Margin="0,10,0,0" FontSize="38" FontWeight="SemiBold" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.RisingStarsCount}" />
                                                <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="{DynamicResource MutedForegroundBrush}" Text="{loc:Loc Key=Analytics_Card_RisingStarsHint}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource SectionPanelStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_ProfileOverview_Title}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           Text="{loc:Loc Key=Analytics_ProfileOverview_Subtitle}" />
                                                <Canvas Margin="0,10,0,0" Width="350" Height="300">
                                                    <Polygon Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" Fill="Transparent" Points="165,38 262,94 262,206 165,262 68,206 68,94" />
                                                    <Polygon Stroke="{DynamicResource ChartGridBrush}" StrokeThickness="1" Fill="Transparent" Points="165,66 238,108 238,192 165,234 92,192 92,108" />
                                                    <Line X1="165" Y1="38" X2="165" Y2="262" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1" />
                                                    <Line X1="68" Y1="94" X2="262" Y2="206" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1" />
                                                    <Line X1="262" Y1="94" X2="68" Y2="206" Stroke="{DynamicResource ChartAxisBrush}" StrokeThickness="1" />
                                                    <Polygon Stroke="{DynamicResource SuccessForegroundBrush}" StrokeThickness="2" Fill="{DynamicResource RadarFillBrush}" Points="{Binding Analytics.RadarPlayerOnePoints}" />
                                                    <Polygon Stroke="{DynamicResource BlueAccentBrush}" StrokeThickness="2" Fill="{DynamicResource BlueAccentFillBrush}" Points="{Binding Analytics.RadarPlayerTwoPoints}" />
                                                </Canvas>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock FontSize="16" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding Analytics.PlayerOneLegendLabel}" />
                                                    <TextBlock Margin="12,0,0,0" FontSize="16" Foreground="{DynamicResource BlueAccentBrush}" Text="{Binding Analytics.PlayerTwoLegendLabel}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource SectionPanelStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_Trend_Title}" />
                                                <Canvas Margin="0,10,0,0"
                                                        Width="{x:Static viewModels:AnalyticsTrendChartLayout.CanvasWidth}"
                                                        Height="{x:Static viewModels:AnalyticsTrendChartLayout.CanvasHeight}">
                                                    <Line X1="{x:Static viewModels:AnalyticsTrendChartLayout.PlotLeft}"
                                                          Y1="{x:Static viewModels:AnalyticsTrendChartLayout.PlotTop}"
                                                          X2="{x:Static viewModels:AnalyticsTrendChartLayout.PlotLeft}"
                                                          Y2="{x:Static viewModels:AnalyticsTrendChartLayout.PlotBottom}"
                                                          Stroke="{DynamicResource ChartAxisBrush}"
                                                          StrokeThickness="1" />
                                                    <Line X1="{x:Static viewModels:AnalyticsTrendChartLayout.PlotLeft}"
                                                          Y1="{x:Static viewModels:AnalyticsTrendChartLayout.PlotBottom}"
                                                          X2="{x:Static viewModels:AnalyticsTrendChartLayout.PlotRight}"
                                                          Y2="{x:Static viewModels:AnalyticsTrendChartLayout.PlotBottom}"
                                                          Stroke="{DynamicResource ChartAxisBrush}"
                                                          StrokeThickness="1" />
                                                    <Line X1="{x:Static viewModels:AnalyticsTrendChartLayout.PlotLeft}"
                                                          Y1="{x:Static viewModels:AnalyticsTrendChartLayout.GridTop}"
                                                          X2="{x:Static viewModels:AnalyticsTrendChartLayout.PlotRight}"
                                                          Y2="{x:Static viewModels:AnalyticsTrendChartLayout.GridTop}"
                                                          Stroke="{DynamicResource ChartGridBrush}"
                                                          StrokeThickness="1"
                                                          StrokeDashArray="4,4" />
                                                    <Line X1="{x:Static viewModels:AnalyticsTrendChartLayout.PlotLeft}"
                                                          Y1="{x:Static viewModels:AnalyticsTrendChartLayout.GridMidHigh}"
                                                          X2="{x:Static viewModels:AnalyticsTrendChartLayout.PlotRight}"
                                                          Y2="{x:Static viewModels:AnalyticsTrendChartLayout.GridMidHigh}"
                                                          Stroke="{DynamicResource ChartGridBrush}"
                                                          StrokeThickness="1"
                                                          StrokeDashArray="4,4" />
                                                    <Line X1="{x:Static viewModels:AnalyticsTrendChartLayout.PlotLeft}"
                                                          Y1="{x:Static viewModels:AnalyticsTrendChartLayout.GridMidLow}"
                                                          X2="{x:Static viewModels:AnalyticsTrendChartLayout.PlotRight}"
                                                          Y2="{x:Static viewModels:AnalyticsTrendChartLayout.GridMidLow}"
                                                          Stroke="{DynamicResource ChartGridBrush}"
                                                          StrokeThickness="1"
                                                          StrokeDashArray="4,4" />
                                                    <Polyline Stroke="{DynamicResource SuccessForegroundBrush}" StrokeThickness="3" Points="{Binding Analytics.PerformanceTrendPoints}" />
                                                    <TextBlock Canvas.Left="{x:Static viewModels:AnalyticsTrendChartLayout.AxisLabelX}"
                                                               Canvas.Top="{x:Static viewModels:AnalyticsTrendChartLayout.AxisMinLabelY}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="{Binding Analytics.TrendAxisMin, StringFormat={}{0:0}}" />
                                                    <TextBlock Canvas.Left="{x:Static viewModels:AnalyticsTrendChartLayout.AxisLabelX}"
                                                               Canvas.Top="{x:Static viewModels:AnalyticsTrendChartLayout.AxisMidLowLabelY}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="{Binding Analytics.TrendAxisMidLow, StringFormat={}{0:0}}" />
                                                    <TextBlock Canvas.Left="{x:Static viewModels:AnalyticsTrendChartLayout.AxisLabelX}"
                                                               Canvas.Top="{x:Static viewModels:AnalyticsTrendChartLayout.AxisMidHighLabelY}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="{Binding Analytics.TrendAxisMidHigh, StringFormat={}{0:0}}" />
                                                    <TextBlock Canvas.Left="{x:Static viewModels:AnalyticsTrendChartLayout.AxisLabelX}"
                                                               Canvas.Top="{x:Static viewModels:AnalyticsTrendChartLayout.AxisMaxLabelY}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="{Binding Analytics.TrendAxisMax, StringFormat={}{0:0}}" />
                                                </Canvas>
                                                <ItemsControl Margin="40,6,48,0"
                                                              ItemsSource="{Binding Analytics.TrendPoints}"
                                                              ItemTemplate="{StaticResource AnalyticsTrendLabelTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SectionPanelStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_TopPerformersByRating_Title}" />
                                                <ItemsControl Margin="0,12,0,0"
                                                              ItemsSource="{Binding Analytics.TopPerformerBars}"
                                                              ItemTemplate="{StaticResource AnalyticsTopPerformerBarTemplate}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SectionPanelStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_OverallVsPotential_Title}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           Text="{loc:Loc Key=Analytics_OverallVsPotential_Subtitle}" />
                                                <ItemsControl Margin="0,12,0,0"
                                                              ItemsSource="{Binding Analytics.GoalsAssistsBars}"
                                                              ItemTemplate="{StaticResource AnalyticsGoalsAssistsBarTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Margin="0,12,0,0" Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_TopPerformersDetailed_Title}" />
                                            <ItemsControl Margin="0,12,0,0"
                                                          ItemsSource="{Binding Analytics.TopPerformerCards}"
                                                          ItemTemplate="{StaticResource AnalyticsTopPerformerCardTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SectionPanelStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_LeagueCompetitiveness_Title}" />
                                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Analytics.LeagueCompetitiveness}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding LeagueName}" />
                                                                    <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding CountryName}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                    <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}">
                                                                        <Run Text="{Binding MatchCount}" />
                                                                        <Run Text=" " />
                                                                        <Run Text="{loc:Loc Key=Analytics_Competitiveness_Matches}" />
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="14" Foreground="{DynamicResource SuccessForegroundBrush}">
                                                                        <Run Text="{Binding DrawRate, StringFormat={}{0:0.0}%}" />
                                                                        <Run Text=" " />
                                                                        <Run Text="{loc:Loc Key=Analytics_Competitiveness_DrawRate}" />
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}">
                                                                        <Run Text="{Binding AverageGoalDifference, StringFormat={}{0:0.00}}" />
                                                                        <Run Text=" " />
                                                                        <Run Text="{loc:Loc Key=Analytics_Competitiveness_AvgDiff}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SectionPanelStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Loc Key=Analytics_RatingDelta_Title}" />
                                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Analytics.TopRatingDeltas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding PlayerName}" />
                                                                <TextBlock Grid.Column="1" FontSize="15" Foreground="{DynamicResource SuccessForegroundBrush}">
                                                                    <Run Text="{Binding Overall}" />
                                                                    <Run Text=" -> " />
                                                                    <Run Text="{Binding Potential}" />
                                                                    <Run Text=" (+" />
                                                                    <Run Text="{Binding Delta}" />
                                                                    <Run Text=")" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    
</UserControl>
