<UserControl x:Class="ProFootball.Presentation.Views.CountriesLeaguesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProFootball.Presentation.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
                        <Grid Margin="6,2,6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock FontSize="38"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="{loc:Loc Key=CountriesLeagues_Countries_Title}" />

                                    <ListBox Grid.Row="1"
                                             Margin="0,18,0,18"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding CountriesLeagues.Countries}"
                                             SelectedItem="{Binding CountriesLeagues.SelectedCountry, Mode=TwoWay}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,0,10" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="CountryCard"
                                                                    Padding="14"
                                                                    Background="{DynamicResource SelectionSurfaceBrush}"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="2"
                                                                    CornerRadius="10">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CountryCard" Property="Background" Value="{DynamicResource SelectionActiveSurfaceBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="CountryCard" Property="Background" Value="{DynamicResource SelectionActiveSurfaceBrush}" />
                                                                    <Setter TargetName="CountryCard" Property="BorderBrush" Value="{DynamicResource SuccessForegroundBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="30"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="24"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}">
                                                            <Run Text="{Binding Path=LeagueCount, Mode=OneWay}" />
                                                            <Run Text="{loc:Loc Key=CountriesLeagues_Info_LeaguesSuffix}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource StatusBadgeStyle}"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                                   Text="{Binding LeagueCount}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="54"
                                                        Height="54"
                                                        Padding="8"
                                                        Background="{DynamicResource SuccessSoftBackgroundBrush}"
                                                        CornerRadius="10">
                                                    <TextBlock
                                                               FontSize="26"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                                               Text="{Binding CountriesLeagues.SelectedCountryFlag}" />
                                                </Border>
                                                <StackPanel Margin="12,0,0,0">
                                                    <TextBlock FontSize="50"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{Binding CountriesLeagues.SelectedCountryName}" />
                                                    <TextBlock FontSize="30"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                Text="{loc:Loc Key=CountriesLeagues_Leagues_Title}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Top">
                                                <Button Width="160"
                                                        Height="44"
                                                        Margin="0,0,12,0"
                                                        Background="{DynamicResource SuccessForegroundBrush}"
                                                        Foreground="White"
                                                        FontSize="22"
                                                        Content="{loc:Loc Key=CountriesLeagues_Add_Button}"
                                                        Command="{Binding CountriesLeagues.OpenAddLeagueModalCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanManageData}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Border Padding="10,6"
                                                        Margin="0,0,0,0"
                                                        Background="{DynamicResource SuccessSoftBackgroundBrush}"
                                                        CornerRadius="8"
                                                        Visibility="{Binding CountriesLeagues.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontSize="20"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                                                Text="{loc:Loc Key=Common_Loading}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,10,0,0"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Text="{Binding CountriesLeagues.LeagueNamesLine}" />

                                        <Grid Grid.Row="2" Margin="0,16,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <ItemsControl Grid.Row="0"
                                                          ItemsSource="{Binding CountriesLeagues.LeagueCards}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="14"
                                                                Margin="0,0,0,12"
                                                                Background="{DynamicResource SelectionSurfaceBrush}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Padding="8"
                                                                            Background="{DynamicResource SuccessSoftBackgroundBrush}"
                                                                            CornerRadius="8">
                                                                        <TextBlock
                                                                                   FontSize="20"
                                                                                   Foreground="{DynamicResource SuccessForegroundBrush}"
                                                                                   Text="{Binding DataContext.CountriesLeagues.SelectedCountryFlag, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                        <TextBlock FontSize="32"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                                                   Text="{Binding LeagueName}" />
                                                                        <TextBlock Margin="0,2,0,0"
                                                                                   FontSize="22"
                                                                                   Foreground="{DynamicResource MutedForegroundBrush}">
                                                                            <Run Text="{loc:Loc Key=CountriesLeagues_Info_LeagueId}" />
                                                                            <Run Text="{Binding Path=LeagueId, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Separator Grid.Row="1" Margin="0,10,0,10" />
                                                                <Grid Grid.Row="2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock FontSize="24"
                                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                    Text="{loc:Loc Key=CountriesLeagues_Metric_Teams}" />
                                                                        <TextBlock Margin="0,2,0,0"
                                                                                   FontSize="34"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                                                   Text="{Binding TeamsCount}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock FontSize="24"
                                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                    Text="{loc:Loc Key=CountriesLeagues_Metric_Matches}" />
                                                                        <TextBlock Margin="0,2,0,0"
                                                                                   FontSize="34"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                                                   Text="{Binding MatchCount}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock FontSize="24"
                                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                                    Text="{loc:Loc Key=CountriesLeagues_Metric_Season}" />
                                                                        <ComboBox Margin="0,8,0,0"
                                                                                  MinWidth="180"
                                                                                  Style="{StaticResource PlayersFilterComboBoxStyle}"
                                                                                  ItemsSource="{Binding DataContext.CountriesLeagues.FeaturedLeagueSeasons, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                  SelectedItem="{Binding DataContext.CountriesLeagues.SelectedFeaturedSeason, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Grid.Row="1"
                                                    Padding="12"
                                                    Margin="0,0,0,12"
                                                    Background="{DynamicResource SelectionSurfaceBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock FontSize="24"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{loc:Loc Key=CountriesLeagues_Standings_Title}" />
                                                    <TextBlock Grid.Row="1"
                                                               Margin="0,2,0,10"
                                                               FontSize="18"
                                                               Foreground="{DynamicResource MutedForegroundBrush}">
                                                        <Run Text="{Binding CountriesLeagues.FeaturedLeagueName, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding CountriesLeagues.FeaturedLeagueSeason, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <DataGrid Grid.Row="2"
                                                              Height="340"
                                                              AutoGenerateColumns="False"
                                                              CanUserAddRows="False"
                                                              CanUserDeleteRows="False"
                                                              CanUserReorderColumns="False"
                                                              CanUserResizeRows="False"
                                                              IsReadOnly="True"
                                                              HeadersVisibility="Column"
                                                              ItemsSource="{Binding CountriesLeagues.FeaturedLeagueStandings}"
                                                              GridLinesVisibility="None"
                                                              RowHeaderWidth="0"
                                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Width="56" Binding="{Binding Position}" Header="#" />
                                                            <DataGridTextColumn Width="*" Binding="{Binding TeamName}" Header="{loc:Loc Key=CountriesLeagues_Standings_Team}" />
                                                            <DataGridTextColumn Width="56" Binding="{Binding Wins}" Header="{loc:Loc Key=CountriesLeagues_Standings_W}" />
                                                            <DataGridTextColumn Width="56" Binding="{Binding Draws}" Header="{loc:Loc Key=CountriesLeagues_Standings_D}" />
                                                            <DataGridTextColumn Width="56" Binding="{Binding Losses}" Header="{loc:Loc Key=CountriesLeagues_Standings_L}" />
                                                            <DataGridTextColumn Width="66" Binding="{Binding GoalsFor}" Header="{loc:Loc Key=CountriesLeagues_Standings_GF}" />
                                                            <DataGridTextColumn Width="66" Binding="{Binding GoalsAgainst}" Header="{loc:Loc Key=CountriesLeagues_Standings_GA}" />
                                                            <DataGridTextColumn Width="56" Binding="{Binding Points}" Header="{loc:Loc Key=CountriesLeagues_Standings_PTS}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="2"
                                                   Margin="0,20,0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                    Text="{loc:Loc Key=CountriesLeagues_NoLeagues}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CountriesLeagues.IsLoading}" Value="False" />
                                                                <Condition Binding="{Binding CountriesLeagues.LeagueCards.Count}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Border Margin="0,14,0,0"
                                        Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="42"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                    Text="{loc:Loc Key=CountriesLeagues_Information_Title}" />
                                        <TextBlock Margin="0,14,0,0"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Text="{Binding CountriesLeagues.SelectedCountryAboutTitle}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="26"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CountriesLeagues.EffectiveCountryDescription}" />
                                        <Separator Margin="0,14,0,14" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Padding="14"
                                                    Background="{DynamicResource PanelMutedBackgroundBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock FontSize="24"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                Text="{loc:Loc Key=CountriesLeagues_Summary_TotalClubs}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="44"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{Binding CountriesLeagues.TotalClubs}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Padding="14"
                                                    Background="{DynamicResource PanelMutedBackgroundBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock FontSize="24"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                Text="{loc:Loc Key=CountriesLeagues_Summary_ActiveLeagues}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="44"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{Binding CountriesLeagues.ActiveLeagues}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.ColumnSpan="3"
                                  Panel.ZIndex="1000"
                                  Background="#99000000"
                                  Visibility="{Binding CountriesLeagues.IsAddLeagueModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Width="560"
                                        Padding="22"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="36"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TitleForegroundBrush}"
                                                           Text="{loc:Loc Key=CountriesLeagues_Add_Title}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           Text="{loc:Loc Key=CountriesLeagues_Add_Subtitle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource MutedForegroundBrush}"
                                                    Content="&#xE711;"
                                                    Command="{Binding CountriesLeagues.CloseAddLeagueModalCommand}" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                            <TextBlock FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TitleForegroundBrush}"
                                                       Text="{loc:Loc Key=CountriesLeagues_Add_Name}" />
                                            <TextBox Margin="0,8,0,0"
                                                     Style="{StaticResource AuthInputTextBoxStyle}"
                                                     Text="{Binding CountriesLeagues.NewLeagueName, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Margin="0,14,0,0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TitleForegroundBrush}"
                                                       Text="{loc:Loc Key=CountriesLeagues_Add_MaxTeams}" />
                                            <TextBox Margin="0,8,0,0"
                                                     Style="{StaticResource AuthInputTextBoxStyle}"
                                                     Text="{Binding CountriesLeagues.NewLeagueMaxTeams, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Margin="0,14,0,0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TitleForegroundBrush}"
                                                       Text="{loc:Loc Key=CountriesLeagues_Add_Country}" />
                                            <ComboBox Margin="0,8,0,0"
                                                      Style="{StaticResource PlayersFilterComboBoxStyle}"
                                                      ItemsSource="{Binding CountriesLeagues.CountryOptions}"
                                                      SelectedItem="{Binding CountriesLeagues.SelectedCountryForNewLeague, Mode=TwoWay}"
                                                      DisplayMemberPath="Name"
                                                      TextSearch.TextPath="Name" />

                                            <TextBlock Margin="0,14,0,0"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TitleForegroundBrush}"
                                                       Text="{loc:Loc Key=CountriesLeagues_Add_Description}" />
                                            <TextBox Margin="0,8,0,0"
                                                     Height="84"
                                                     VerticalContentAlignment="Top"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Style="{StaticResource AuthInputTextBoxStyle}"
                                                     Text="{Binding CountriesLeagues.NewLeagueDescription, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                    Margin="0,20,0,0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Width="150"
                                                    Margin="0,0,10,0"
                                                    Content="{loc:Loc Key=Common_Action_Cancel}"
                                                    Command="{Binding CountriesLeagues.CloseAddLeagueModalCommand}" />
                                            <Button Width="190"
                                                    Background="{DynamicResource SuccessForegroundBrush}"
                                                    Foreground="White"
                                                    Content="{loc:Loc Key=CountriesLeagues_Add_Confirm}"
                                                    Command="{Binding CountriesLeagues.AddLeagueCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    
</UserControl>


