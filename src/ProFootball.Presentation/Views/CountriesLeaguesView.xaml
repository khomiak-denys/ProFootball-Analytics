<UserControl x:Class="ProFootball.Presentation.Views.CountriesLeaguesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
                        <Grid Margin="6,2,6,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SectionPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock FontSize="38"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               Text="Countries" />

                                    <ListBox Grid.Row="1"
                                             Margin="0,18,0,18"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding CountriesLeagues.Countries}"
                                             SelectedItem="{Binding CountriesLeagues.SelectedCountry, Mode=TwoWay}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,0,10" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="CountryCard"
                                                                    Padding="14"
                                                                    Background="{DynamicResource SelectionSurfaceBrush}"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="2"
                                                                    CornerRadius="10">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CountryCard" Property="Background" Value="{DynamicResource SelectionActiveSurfaceBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="CountryCard" Property="Background" Value="{DynamicResource SelectionActiveSurfaceBrush}" />
                                                                    <Setter TargetName="CountryCard" Property="BorderBrush" Value="{DynamicResource SuccessForegroundBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="30"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="24"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                   Text="{Binding LeagueCount, StringFormat={}{0} leagues}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource StatusBadgeStyle}"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                                   Text="{Binding LeagueCount}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Grid.Row="2"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock FontSize="26"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Text="{Binding CountriesLeagues.TotalCountries, StringFormat=Total Countries: {0}}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="26"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Text="{Binding CountriesLeagues.TotalLeagues, StringFormat=Total Leagues: {0}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Padding="10"
                                                        Background="{DynamicResource SuccessSoftBackgroundBrush}"
                                                        CornerRadius="10">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               FontSize="26"
                                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                                               Text="&#xE7BF;" />
                                                </Border>
                                                <StackPanel Margin="12,0,0,0">
                                                    <TextBlock FontSize="50"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{Binding CountriesLeagues.SelectedCountryName}" />
                                                    <TextBlock FontSize="30"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="Football Leagues" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Top">
                                                <Border Padding="10,6"
                                                        Margin="0,0,0,0"
                                                        Background="{DynamicResource SuccessSoftBackgroundBrush}"
                                                        CornerRadius="8"
                                                        Visibility="{Binding CountriesLeagues.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontSize="20"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                                               Text="Loading..." />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,10,0,0"
                                                   FontSize="22"
                                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                                   Text="{Binding CountriesLeagues.ErrorMessage}" />

                                        <ItemsControl Grid.Row="2"
                                                      Margin="0,16,0,0"
                                                      ItemsSource="{Binding CountriesLeagues.LeagueCards}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0,0,12,0" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="14"
                                                            Margin="0,0,0,12"
                                                            Background="{DynamicResource SelectionSurfaceBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Padding="8"
                                                                        Background="{DynamicResource SuccessSoftBackgroundBrush}"
                                                                        CornerRadius="8">
                                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="20"
                                                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                                                               Text="&#xE7BF;" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                    <TextBlock FontSize="32"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                                               Text="{Binding LeagueName}" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="22"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                               Text="{Binding LeagueId, StringFormat=League ID: {0}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <Separator Grid.Row="1" Margin="0,10,0,10" />
                                                            <Grid Grid.Row="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock FontSize="24"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                               Text="Teams" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="34"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                                               Text="{Binding TeamsCount}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock FontSize="24"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                               Text="Matches" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="34"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                                               Text="{Binding MatchesCount}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock FontSize="24"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                               Text="Season" />
                                                                    <TextBlock Margin="0,2,0,0"
                                                                               FontSize="34"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                                               Text="{Binding Season}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Row="2"
                                                   Margin="0,20,0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Text="No leagues found for selected country.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CountriesLeagues.IsLoading}" Value="False" />
                                                                <Condition Binding="{Binding CountriesLeagues.LeagueCards.Count}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Border Margin="0,14,0,0"
                                        Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="42"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   Text="League Information" />
                                        <TextBlock Margin="0,14,0,0"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Text="{Binding CountriesLeagues.SelectedCountryAboutTitle}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="26"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CountriesLeagues.SelectedCountryDescription}" />
                                        <Separator Margin="0,14,0,14" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Padding="14"
                                                    Background="{DynamicResource PanelMutedBackgroundBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock FontSize="24"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="Total Clubs" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="44"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{Binding CountriesLeagues.TotalClubs}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Padding="14"
                                                    Background="{DynamicResource PanelMutedBackgroundBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock FontSize="24"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="Active Leagues" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="44"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{Binding CountriesLeagues.ActiveLeagues}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4"
                                                    Padding="14"
                                                    Background="{DynamicResource PanelMutedBackgroundBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock FontSize="24"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="Divisions" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="44"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{Binding CountriesLeagues.Divisions}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    
</UserControl>