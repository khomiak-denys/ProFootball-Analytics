<Window x:Class="ProFootball.Presentation.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sign In"
        Height="560"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellMainBackgroundBrush}">
    <Grid Margin="20">
        <Border Style="{StaticResource ReactCardBorderStyle}" Margin="0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SuccessForegroundBrush}" Padding="20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="8"
                                Background="White">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{DynamicResource SuccessForegroundBrush}"
                                       Text="&#xE77B;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="ProFootball Analytics" />
                            <TextBlock FontSize="12"
                                       Foreground="White"
                                       Opacity="0.82"
                                       Text="Data Analysis Platform" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,20,24,24">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Text="Вхід" />

                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Text="Увійдіть з логіном та паролем." />

                    <TextBlock Margin="0,22,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Text="Логін" />
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,14,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Text="Пароль" />
                    <PasswordBox x:Name="PasswordInput"
                                 Height="40"
                                 Padding="12,0"
                                 FontSize="16"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TitleForegroundBrush}" />

                    <Border Margin="0,14,0,0"
                            Background="#11D4183D"
                            BorderBrush="{DynamicResource DangerForegroundBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <TextBlock Foreground="{DynamicResource DangerForegroundBrush}"
                                   Text="{Binding ErrorMessage}" />
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Button Margin="0,18,0,0"
                            Content="Увійти"
                            Background="{DynamicResource SuccessForegroundBrush}"
                            Foreground="White"
                            Click="OnSignInClick" />

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Немає облікового запису?" />
                        <Button Margin="6,0,0,0"
                                Padding="6,0"
                                Height="24"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource SuccessForegroundBrush}"
                                Content="Зареєструватися"
                                Click="OnOpenRegistrationClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
