<UserControl x:Class="ProFootball.Presentation.Views.PlayerDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
             mc:Ignorable="d">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SectionPanelStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Margin="0,6,10,0" Style="{StaticResource TypographyLabel}" Text="PlayerApiId:" />
                                        <TextBox Width="160"
                                                 Margin="0,0,12,0"
                                                 Text="{Binding PlayerDetails.SelectedPlayerApiId, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Width="120" Content="Load" Command="{Binding PlayerDetails.LoadCommand}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TypographyH2}" Text="{Binding PlayerDetails.Details.Name}" />
                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="420" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Canvas Width="380" Height="160" Background="{DynamicResource PanelMutedBackgroundBrush}">
                                            <Polyline Stroke="{DynamicResource AmberAccentBrush}"
                                                      StrokeThickness="2"
                                                      Points="{Binding PlayerDetails.TrendPoints, Converter={StaticResource TrendToPointsConverter}, ConverterParameter=overall}" />
                                            <Polyline Stroke="{DynamicResource BlueAccentBrush}"
                                                      StrokeThickness="2"
                                                      Points="{Binding PlayerDetails.TrendPoints, Converter={StaticResource TrendToPointsConverter}, ConverterParameter=potential}" />
                                        </Canvas>
                                        <DataGrid Grid.Column="2"
                                                  ItemsSource="{Binding PlayerDetails.Attributes}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="130" />
                                                <DataGridTextColumn Header="Overall" Binding="{Binding OverallRating}" Width="80" />
                                                <DataGridTextColumn Header="Potential" Binding="{Binding Potential}" Width="80" />
                                                <DataGridTextColumn Header="Foot" Binding="{Binding PreferredFoot}" Width="80" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    
</UserControl>