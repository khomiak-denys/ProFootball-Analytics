<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#0F1214</Color>
    <Color x:Key="Color.Card">#1A1D1F</Color>
    <Color x:Key="Color.Primary">#22C55E</Color>
    <Color x:Key="Color.Border">#2D3236</Color>
    <Color x:Key="Color.Sidebar">#1A1D1F</Color>
    <Color x:Key="Color.Text">#F8F9FA</Color>
    <Color x:Key="Color.MutedText">#9CA3AF</Color>
    <Color x:Key="Color.HeaderBackground">#1A1D1F</Color>

    <SolidColorBrush x:Key="ShellMainBackgroundBrush" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="ShellSidebarBrush" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource Color.MutedText}" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="{StaticResource Color.Primary}" />

    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#F87171" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#22272A" />
    <SolidColorBrush x:Key="SelectionSurfaceBrush" Color="#23282B" />
    <SolidColorBrush x:Key="SelectionActiveSurfaceBrush" Color="#1D2A22" />
    <SolidColorBrush x:Key="BadgeSurfaceBrush" Color="#2B3135" />
    <SolidColorBrush x:Key="ChartAxisBrush" Color="#8B96A5" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#2D3236" />
    <SolidColorBrush x:Key="RadarFillBrush" Color="#7D22C55E" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#23282B" />
    <SolidColorBrush x:Key="SidebarFocusBackgroundBrush" Color="#2D3236" />
    <SolidColorBrush x:Key="SidebarFocusBorderBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SidebarSecondaryForegroundBrush" Color="#F8F9FA" Opacity="0.75" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#2D3236" />
    <SolidColorBrush x:Key="SuccessSoftBackgroundBrush" Color="#1D2A22" />
    <SolidColorBrush x:Key="BlueAccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="BlueAccentFillBrush" Color="#663B82F6" />
    <SolidColorBrush x:Key="AmberAccentBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="SegmentBackgroundBrush" Color="#2B3135" />
    <SolidColorBrush x:Key="SegmentSelectedBackgroundBrush" Color="#1F2428" />
    <SolidColorBrush x:Key="PanelMutedBackgroundBrush" Color="#23282B" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource Color.HeaderBackground}" />
</ResourceDictionary>
