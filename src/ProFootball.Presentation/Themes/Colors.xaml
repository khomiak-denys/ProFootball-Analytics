<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- React design tokens extracted from src/styles/theme.css -->
    <Color x:Key="BackgroundColor">#F8F9FA</Color>
    <Color x:Key="ForegroundColor">#1A1D1F</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardForegroundColor">#1A1D1F</Color>
    <Color x:Key="PrimaryColor">#22C55E</Color>
    <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
    <Color x:Key="SecondaryColor">#F1F3F5</Color>
    <Color x:Key="SecondaryForegroundColor">#1A1D1F</Color>
    <Color x:Key="MutedColor">#E9ECEF</Color>
    <Color x:Key="MutedForegroundColor">#6C757D</Color>
    <Color x:Key="AccentColor">#22C55E</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="DestructiveColor">#D4183D</Color>
    <Color x:Key="DestructiveForegroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#DEE2E6</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="RingColor">#22C55E</Color>

    <Color x:Key="Chart1Color">#22C55E</Color>
    <Color x:Key="Chart2Color">#3B82F6</Color>
    <Color x:Key="Chart3Color">#F59E0B</Color>
    <Color x:Key="Chart4Color">#8B5CF6</Color>
    <Color x:Key="Chart5Color">#EF4444</Color>

    <Color x:Key="SidebarColor">#1A1D1F</Color>
    <Color x:Key="SidebarForegroundColor">#F8F9FA</Color>
    <Color x:Key="SidebarPrimaryColor">#22C55E</Color>
    <Color x:Key="SidebarPrimaryForegroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarAccentColor">#2D3236</Color>
    <Color x:Key="SidebarAccentForegroundColor">#F8F9FA</Color>
    <Color x:Key="SidebarBorderColor">#2D3236</Color>

    <!-- Material Design color tokens -->
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#52D27F" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#1A9D4A" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#F5F7F9" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#D9DEE3" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />

    <!-- Project aliases for existing styles -->
    <SolidColorBrush x:Key="ShellMainBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ShellSidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource CardColor}" />

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="TitleForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}" />

    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SuccessSoftBackgroundBrush" Color="#EAF8EF" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{StaticResource DestructiveColor}" />

    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="PanelMutedBackgroundBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="SelectionSurfaceBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="SelectionActiveSurfaceBrush" Color="#E7F7EC" />
    <SolidColorBrush x:Key="BadgeSurfaceBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SegmentBackgroundBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SegmentSelectedBackgroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ChartAxisBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="RadarFillBrush" Color="#7D22C55E" />
    <SolidColorBrush x:Key="BlueAccentBrush" Color="{StaticResource Chart2Color}" />
    <SolidColorBrush x:Key="BlueAccentFillBrush" Color="#663B82F6" />
    <SolidColorBrush x:Key="AmberAccentBrush" Color="{StaticResource Chart3Color}" />

    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="{StaticResource SidebarPrimaryColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarAccentColor}" />
    <SolidColorBrush x:Key="SidebarFocusBackgroundBrush" Color="{StaticResource SidebarAccentColor}" />
    <SolidColorBrush x:Key="SidebarFocusBorderBrush" Color="{StaticResource SidebarPrimaryColor}" />
    <SolidColorBrush x:Key="SidebarSecondaryForegroundBrush" Color="{StaticResource SidebarForegroundColor}" Opacity="0.75" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="{StaticResource SidebarBorderColor}" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="RingBrush" Color="{StaticResource RingColor}" />
</ResourceDictionary>
