<Window x:Class="ProFootball.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:ProFootball.Presentation.Localization"
        xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
        xmlns:views="clr-namespace:ProFootball.Presentation.Views"
        mc:Ignorable="d"
        Title="ProFootball"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="1024"
        Width="1440"
        MinHeight="1024"
        MinWidth="1440"
        ResizeMode="CanResize"
        Background="{DynamicResource ShellMainBackgroundBrush}">
    <Grid>
        <Grid Visibility="{Binding ShowAuthenticatedShell, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ShellSidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,28,24,22">
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="{loc:Loc Key=Main_Brand_Title}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource SidebarSecondaryForegroundBrush}"
                                   Text="{loc:Loc Key=Main_Brand_Subtitle}" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Margin="16,6,16,16"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectedValuePath="Tag"
                             SelectedValue="{Binding SelectedSidebarTab, Mode=TwoWay}"
                             PreviewMouseLeftButtonUp="OnSidebarItemMouseLeftButtonUp"
                             ItemContainerStyle="{StaticResource SidebarNavItemStyle}">
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Dashboard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" Text="&#xE80F;" />
                                <TextBlock Margin="14,0,0,0" FontSize="16" Foreground="White" Text="{loc:Loc Key=Main_Sidebar_Dashboard}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Players}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" Text="&#xE716;" />
                                <TextBlock Margin="14,0,0,0" FontSize="16" Foreground="White" Text="{loc:Loc Key=Main_Sidebar_Players}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Teams}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" Text="&#xE72E;" />
                                <TextBlock Margin="14,0,0,0" FontSize="16" Foreground="White" Text="{loc:Loc Key=Main_Sidebar_Teams}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Matches}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" Text="&#xE787;" />
                                <TextBlock Margin="14,0,0,0" FontSize="16" Foreground="White" Text="{loc:Loc Key=Main_Sidebar_Matches}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.CountriesLeagues}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" Text="&#xE909;" />
                                <TextBlock Margin="14,0,0,0" FontSize="16" Foreground="White" Text="{loc:Loc Key=Main_Sidebar_Leagues}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Analytics}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" Text="&#xE9D2;" />
                                <TextBlock Margin="14,0,0,0" FontSize="16" Foreground="White" Text="{loc:Loc Key=Main_Sidebar_Analytics}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="2" Padding="16,20" BorderBrush="{DynamicResource SidebarDividerBrush}" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SidebarSecondaryForegroundBrush}"
                                   Text="{Binding Dashboard.CurrentYear, StringFormat={}© {0} ProFootball Analytics}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   Text="{Binding CurrentSectionTitle}" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Button x:Name="UserMenuButton"
                                        Padding="12,0"
                                        Height="40"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Command="{Binding ToggleUserMenuCommand}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                Background="{DynamicResource SuccessSoftBackgroundBrush}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource SuccessForegroundBrush}"
                                                       Text="&#xE77B;" />
                                        </Border>
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   Text="{Binding CurrentUserDisplayName}" />
                                        <Border Margin="10,0,0,0"
                                                Padding="8,3"
                                                Background="{DynamicResource BadgeSurfaceBrush}"
                                                CornerRadius="999">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TitleForegroundBrush}"
                                                           Text="{Binding CurrentUserRole}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Popup IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=UserMenuButton}"
                                       Placement="Bottom"
                                       VerticalOffset="8"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Width="170"
                                            Padding="6"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <StackPanel>
                                            <Button HorizontalContentAlignment="Left"
                                                    Padding="10,8"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding OpenSettingsCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="&#xE713;" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                                               Text="{loc:Loc Key=Main_UserMenu_Settings}" />
                                                </StackPanel>
                                            </Button>
                                            <Button HorizontalContentAlignment="Left"
                                                    Padding="10,8"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding LogoutCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource DangerForegroundBrush}"
                                                               Text="&#xE8AC;" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               Foreground="{DynamicResource DangerForegroundBrush}"
                                                               Text="{loc:Loc Key=Main_UserMenu_Logout}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18,16,18,16">
                    <TabControl Style="{StaticResource ContentOnlyTabControlStyle}"
                                Background="{DynamicResource ShellMainBackgroundBrush}"
                                SelectedValuePath="Tag"
                                SelectedValue="{Binding SelectedTab, Mode=TwoWay}">
                        <TabItem Header="{loc:Loc Key=Main_Tab_Dashboard}" Tag="{x:Static viewModels:AppTab.Dashboard}">
                            <views:DashboardView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_CountriesLeagues}" Tag="{x:Static viewModels:AppTab.CountriesLeagues}">
                            <views:CountriesLeaguesView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_Teams}" Tag="{x:Static viewModels:AppTab.Teams}">
                            <views:TeamsView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_TeamDetails}" Tag="{x:Static viewModels:AppTab.TeamDetails}">
                            <views:TeamDetailsView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_Players}" Tag="{x:Static viewModels:AppTab.Players}">
                            <views:PlayersView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_PlayerDetails}" Tag="{x:Static viewModels:AppTab.PlayerDetails}">
                            <views:PlayerDetailsView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_Matches}" Tag="{x:Static viewModels:AppTab.Matches}">
                            <views:MatchesView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_MatchDetails}" Tag="{x:Static viewModels:AppTab.MatchDetails}">
                            <views:MatchDetailsView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_Analytics}" Tag="{x:Static viewModels:AppTab.Analytics}">
                            <views:AnalyticsView />
                        </TabItem>

                        <TabItem Header="{loc:Loc Key=Main_Tab_Settings}" Tag="{x:Static viewModels:AppTab.Settings}">
                            <views:SettingsView />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>

          <Grid Visibility="{Binding ShowAuthScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.25,0.2" Center="0.25,0.2" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#F1F6F2" Offset="0" />
                    <GradientStop Color="#F7F8FA" Offset="0.55" />
                    <GradientStop Color="#E9ECEF" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Button Width="34"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    ToolTip="{loc:Loc Key=Auth_AboutSystem_Button}"
                    Content="&#xE946;"
                    Click="OnAboutSystemClick" />

            <Border Width="760"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Background="White"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource SuccessForegroundBrush}" Padding="24,20">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="10"
                                    Background="White">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="{DynamicResource SuccessForegroundBrush}"
                                           Text="&#xE77B;" />
                            </Border>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{loc:Loc Key=Main_Brand_Title}" />
                                <TextBlock FontSize="13"
                                           Foreground="White"
                                           Opacity="0.85"
                                           Text="{loc:Loc Key=Main_Brand_Subtitle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,8,20,8" VerticalAlignment="Center">
                            <TextBlock FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleForegroundBrush}"
                                       Text="{loc:Loc Key=Auth_Access_Title}" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="16"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Loc Key=Auth_Access_Description}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20">
                            <TabControl x:Name="AuthTabs"
                                        Style="{StaticResource ContentOnlyTabControlStyle}"
                                        SelectedIndex="0">
                                <TabItem Header="{loc:Loc Key=Auth_Tab_SignIn}">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Text="{loc:Loc Key=Auth_SignIn_Title}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Text="{loc:Loc Key=Auth_SignIn_Description}" />

                                        <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" Text="{loc:Loc Key=Auth_Field_Login}" />
                                        <TextBox Style="{StaticResource AuthInputTextBoxStyle}"
                                                 Text="{Binding LoginForm.Login, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Margin="0,14,0,6" FontWeight="SemiBold" Text="{loc:Loc Key=Auth_Field_Password}" />
                                        <PasswordBox x:Name="LoginPasswordBox"
                                                     Style="{StaticResource AuthInputPasswordBoxStyle}" />

                                        <Border Margin="0,14,0,0"
                                                Padding="10,8"
                                                Background="#11D4183D"
                                                BorderBrush="{DynamicResource DangerForegroundBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBlock Foreground="{DynamicResource DangerForegroundBrush}"
                                                       Text="{Binding LoginForm.ErrorMessage}" />
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LoginForm.ErrorMessage}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LoginForm.ErrorMessage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Button Margin="0,18,0,0"
                                                Content="{loc:Loc Key=Auth_Action_SignIn}"
                                                Background="{DynamicResource SuccessForegroundBrush}"
                                                Foreground="White"
                                                Click="OnAuthSignInClick" />

                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Text="{loc:Loc Key=Auth_NoAccount}" />
                                            <Button Margin="6,0,0,0"
                                                    Padding="6,0"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource SuccessForegroundBrush}"
                                                    Content="{loc:Loc Key=Auth_Action_Register}"
                                                    Click="OnShowRegisterModeClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="{loc:Loc Key=Auth_Tab_Register}">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Text="{loc:Loc Key=Auth_Register_Title}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Text="{loc:Loc Key=Auth_Register_Description}" />

                                        <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="{loc:Loc Key=Auth_Field_FirstName}" />
                                        <TextBox Style="{StaticResource AuthInputTextBoxStyle}"
                                                 Text="{Binding RegistrationForm.FirstName, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="{loc:Loc Key=Auth_Field_LastName}" />
                                        <TextBox Style="{StaticResource AuthInputTextBoxStyle}"
                                                 Text="{Binding RegistrationForm.LastName, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="{loc:Loc Key=Auth_Field_Login}" />
                                        <TextBox Style="{StaticResource AuthInputTextBoxStyle}"
                                                 Text="{Binding RegistrationForm.Login, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="{loc:Loc Key=Auth_Field_Password}" />
                                        <PasswordBox x:Name="RegisterPasswordBox"
                                                     Style="{StaticResource AuthInputPasswordBoxStyle}" />

                                        <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="{loc:Loc Key=Auth_Field_ConfirmPassword}" />
                                        <PasswordBox x:Name="RegisterConfirmPasswordBox"
                                                     Style="{StaticResource AuthInputPasswordBoxStyle}" />

                                        <TextBlock Margin="0,10,0,0"
                                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                                   Text="{Binding RegistrationForm.ErrorMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RegistrationForm.ErrorMessage}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RegistrationForm.ErrorMessage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Margin="0,10,0,0"
                                                   Foreground="{DynamicResource SuccessForegroundBrush}"
                                                   Text="{Binding RegistrationForm.SuccessMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RegistrationForm.SuccessMessage}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RegistrationForm.SuccessMessage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Margin="0,18,0,0"
                                                Content="{loc:Loc Key=Auth_Action_Register}"
                                                Background="{DynamicResource SuccessForegroundBrush}"
                                                Foreground="White"
                                                Click="OnAuthRegisterClick" />

                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Text="{loc:Loc Key=Auth_HaveAccount}" />
                                            <Button Margin="6,0,0,0"
                                                    Padding="6,0"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource SuccessForegroundBrush}"
                                                    Content="{loc:Loc Key=Auth_Action_SignIn}"
                                                    Click="OnShowLoginModeClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsSessionResolved, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource ShellMainBackgroundBrush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="180" Height="6" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="{loc:Loc Key=Main_RestoringSession}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

