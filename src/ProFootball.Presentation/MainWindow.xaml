<Window x:Class="ProFootball.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ProFootball.Presentation.Converters"
        xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
        mc:Ignorable="d"
        Title="ProFootball MVP"
        Height="900"
        Width="1580"
        Background="{DynamicResource ShellMainBackgroundBrush}">
    <Window.Resources>
        <converters:TrendToPointCollectionConverter x:Key="TrendToPointsConverter" />
        <converters:NullableIntTextConverter x:Key="NullableIntTextConverter" />
        <SolidColorBrush x:Key="ShellSidebarBrush" Color="#101923" />
        <SolidColorBrush x:Key="ShellMainBackgroundBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D6DEE8" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TitleForegroundBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="#64748B" />
        <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="DangerForegroundBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1B2735" />
        <SolidColorBrush x:Key="SidebarFocusBackgroundBrush" Color="#223244" />
        <SolidColorBrush x:Key="SidebarFocusBorderBrush" Color="#93C5FD" />
        <SolidColorBrush x:Key="SidebarSecondaryForegroundBrush" Color="#A3B3C7" />
        <SolidColorBrush x:Key="SidebarDividerBrush" Color="#223244" />

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="DashboardPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="DashboardMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
        </Style>

        <Style x:Key="DashboardMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TitleForegroundBrush}" />
        </Style>

        <Style x:Key="DashboardSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TitleForegroundBrush}" />
        </Style>

        <Style x:Key="SidebarNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavItemBorder"
                                Padding="12,11"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavItemBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavItemBorder" Property="Background" Value="{StaticResource SidebarSelectedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="NavItemBorder" Property="BorderBrush" Value="{StaticResource SidebarFocusBorderBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavItemBorder" Property="Background" Value="{StaticResource SidebarFocusBackgroundBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContentOnlyTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource ShellSidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,28,24,22">
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="ProFootball Analytics" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="{StaticResource SidebarSecondaryForegroundBrush}"
                               Text="Data Analysis Platform" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="16,6,16,16"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SelectedSidebarTab, Mode=TwoWay}"
                         PreviewMouseLeftButtonUp="OnSidebarItemMouseLeftButtonUp"
                         ItemContainerStyle="{StaticResource SidebarNavItemStyle}">
                    <ListBoxItem Tag="{x:Static viewModels:AppTab.Dashboard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="White"
                                       Text="&#xE80F;" />
                            <TextBlock Margin="14,0,0,0"
                                       FontSize="16"
                                       Foreground="White"
                                       Text="Dashboard" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static viewModels:AppTab.Players}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="White"
                                       Text="&#xE716;" />
                            <TextBlock Margin="14,0,0,0"
                                       FontSize="16"
                                       Foreground="White"
                                       Text="Players" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static viewModels:AppTab.Teams}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="White"
                                       Text="&#xE72E;" />
                            <TextBlock Margin="14,0,0,0"
                                       FontSize="16"
                                       Foreground="White"
                                       Text="Teams" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static viewModels:AppTab.Matches}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="White"
                                       Text="&#xE787;" />
                            <TextBlock Margin="14,0,0,0"
                                       FontSize="16"
                                       Foreground="White"
                                       Text="Matches" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static viewModels:AppTab.CountriesLeagues}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="White"
                                       Text="&#xE909;" />
                            <TextBlock Margin="14,0,0,0"
                                       FontSize="16"
                                       Foreground="White"
                                       Text="Leagues" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Static viewModels:AppTab.Analytics}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       Foreground="White"
                                       Text="&#xE9D2;" />
                            <TextBlock Margin="14,0,0,0"
                                       FontSize="16"
                                       Foreground="White"
                                       Text="Analytics" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Border Grid.Row="2"
                        Padding="16,20"
                        BorderBrush="{StaticResource SidebarDividerBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource SidebarSecondaryForegroundBrush}"
                               Text="© 2026 ProFootball Analytics" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid Margin="22,0,22,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Text="{Binding CurrentSectionTitle}" />
                    <Border Width="430"
                            Height="40"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#F8FAFC"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="20">
                        <Grid Margin="14,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#94A3B8"
                                       Text="&#xE721;" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#64748B"
                                       Text="Search players, teams, matches..." />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,16">
                <TabControl Style="{StaticResource ContentOnlyTabControlStyle}"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding SelectedTab, Mode=TwoWay}">
                    <TabItem Header="Dashboard" Tag="{x:Static viewModels:AppTab.Dashboard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,2,6,2">
                                <UniformGrid Columns="5" Margin="0,0,0,14">
                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Countries" />
                                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Countries}" />
                                            <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource SuccessForegroundBrush}" Text="+2 this year" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="#EAF8EF" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource SuccessForegroundBrush}" Text="&#xE909;" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Leagues" />
                                            <TextBlock Margin="0,34,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Leagues}" />
                                            <TextBlock Margin="0,70,0,0" FontSize="14" Foreground="{StaticResource SuccessForegroundBrush}" Text="+5 this year" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="#EAF8EF" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource SuccessForegroundBrush}" Text="&#xE7BF;" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Teams" />
                                            <TextBlock Margin="0,34,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Teams}" />
                                            <TextBlock Margin="0,70,0,0" FontSize="14" Foreground="{StaticResource SuccessForegroundBrush}" Text="+8 this month" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="#EAF8EF" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource SuccessForegroundBrush}" Text="&#xE72E;" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource DashboardCardStyle}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Players" />
                                            <TextBlock Margin="0,34,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Players}" />
                                            <TextBlock Margin="0,70,0,0" FontSize="14" Foreground="{StaticResource DangerForegroundBrush}" Text="-3 this month" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="#EAF8EF" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource SuccessForegroundBrush}" Text="&#xE716;" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="0">
                                        <Grid>
                                            <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Text="Matches" />
                                            <TextBlock Margin="0,34,0,0" Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding Dashboard.Matches}" />
                                            <TextBlock Margin="0,70,0,0" FontSize="14" Foreground="{StaticResource SuccessForegroundBrush}" Text="+24 this week" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Background="#EAF8EF" CornerRadius="10">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource SuccessForegroundBrush}" Text="&#xE787;" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <Border Margin="0,0,0,14"
                                        Style="{StaticResource DashboardPanelStyle}">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource DashboardSectionTitleStyle}"
                                                   Text="Quick Filters" />
                                        <Border Width="210"
                                                Height="42"
                                                Margin="26,0,12,0"
                                                Background="#FFFFFF"
                                                BorderBrush="#D6DEE8"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid Margin="12,0,12,0">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="15"
                                                           Foreground="#1E293B"
                                                           Text="2025/2026" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="18"
                                                           Foreground="#94A3B8"
                                                           Text="&#xE70D;" />
                                            </Grid>
                                        </Border>
                                        <Border Width="230"
                                                Height="42"
                                                Background="#FFFFFF"
                                                BorderBrush="#D6DEE8"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid Margin="12,0,12,0">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="15"
                                                           Foreground="#1E293B"
                                                           Text="All Leagues" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="18"
                                                           Foreground="#94A3B8"
                                                           Text="&#xE70D;" />
                                            </Grid>
                                        </Border>
                                        <Button Width="112"
                                                Height="42"
                                                Margin="12,0,0,0"
                                                Content="Refresh KPI"
                                                Command="{Binding Dashboard.RefreshCommand}" />
                                    </DockPanel>
                                </Border>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Margin="0,0,12,0"
                                            Style="{StaticResource DashboardPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}"
                                                       Text="Average Player Rating Trend" />
                                            <Border Height="300"
                                                    Margin="0,18,0,0"
                                                    Background="{StaticResource SurfaceMutedBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid Margin="10,10,10,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Canvas Width="640" Height="220" HorizontalAlignment="Center">
                                                        <Line X1="40" Y1="20" X2="40" Y2="200" Stroke="#94A3B8" StrokeThickness="1.2" />
                                                        <Line X1="40" Y1="200" X2="620" Y2="200" Stroke="#94A3B8" StrokeThickness="1.2" />

                                                        <Line X1="40" Y1="150" X2="620" Y2="150" Stroke="#D8E0EA" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="40" Y1="85" X2="620" Y2="85" Stroke="#D8E0EA" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="130" Y1="20" X2="130" Y2="200" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="220" Y1="20" X2="220" Y2="200" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="310" Y1="20" X2="310" Y2="200" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="400" Y1="20" X2="400" Y2="200" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="490" Y1="20" X2="490" Y2="200" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="2,2" />

                                                        <Polyline Points="40,155 130,120 220,132 310,98 490,56 620,64"
                                                                  Stroke="{StaticResource SuccessForegroundBrush}"
                                                                  StrokeThickness="2.4" />

                                                        <Ellipse Width="8" Height="8" Canvas.Left="36" Canvas.Top="151" Fill="#FFFFFF" Stroke="{StaticResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="126" Canvas.Top="116" Fill="#FFFFFF" Stroke="{StaticResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="216" Canvas.Top="128" Fill="#FFFFFF" Stroke="{StaticResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="306" Canvas.Top="94" Fill="#FFFFFF" Stroke="{StaticResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="486" Canvas.Top="52" Fill="#FFFFFF" Stroke="{StaticResource SuccessForegroundBrush}" StrokeThickness="2" />
                                                        <Ellipse Width="8" Height="8" Canvas.Left="616" Canvas.Top="60" Fill="#FFFFFF" Stroke="{StaticResource SuccessForegroundBrush}" StrokeThickness="2" />

                                                        <TextBlock Canvas.Left="12" Canvas.Top="193" FontSize="18" Foreground="#64748B" Text="75" />
                                                        <TextBlock Canvas.Left="12" Canvas.Top="142" FontSize="18" Foreground="#64748B" Text="77" />
                                                        <TextBlock Canvas.Left="12" Canvas.Top="76" FontSize="18" Foreground="#64748B" Text="80" />
                                                    </Canvas>

                                                    <UniformGrid Grid.Row="1" Columns="6" Margin="44,-4,10,0">
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Jan" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Feb" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Mar" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Apr" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="May" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Jun" />
                                                    </UniformGrid>

                                                    <TextBlock Grid.Row="2"
                                                               Margin="0,8,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontSize="19"
                                                               Foreground="{StaticResource SuccessForegroundBrush}"
                                                               Text="* Average Rating" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource DashboardPanelStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DashboardSectionTitleStyle}"
                                                       Text="Match Statistics Overview" />
                                            <Border Height="300"
                                                    Margin="0,18,0,0"
                                                    Background="{StaticResource SurfaceMutedBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid Margin="10,10,10,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Canvas Width="640" Height="220" HorizontalAlignment="Center">
                                                        <Line X1="40" Y1="20" X2="40" Y2="200" Stroke="#94A3B8" StrokeThickness="1.2" />
                                                        <Line X1="40" Y1="200" X2="620" Y2="200" Stroke="#94A3B8" StrokeThickness="1.2" />

                                                        <Line X1="40" Y1="128" X2="620" Y2="128" Stroke="#D8E0EA" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="40" Y1="86" X2="620" Y2="86" Stroke="#D8E0EA" StrokeThickness="1" StrokeDashArray="2,2" />
                                                        <Line X1="40" Y1="44" X2="620" Y2="44" Stroke="#D8E0EA" StrokeThickness="1" StrokeDashArray="2,2" />

                                                        <Rectangle Width="100" Height="4" Canvas.Left="55" Canvas.Top="196" Fill="{StaticResource SuccessForegroundBrush}" />
                                                        <Rectangle Width="100" Height="3" Canvas.Left="195" Canvas.Top="197" Fill="{StaticResource SuccessForegroundBrush}" />
                                                        <Rectangle Width="100" Height="26" Canvas.Left="335" Canvas.Top="174" Fill="{StaticResource SuccessForegroundBrush}" />
                                                        <Rectangle Width="100" Height="150" Canvas.Left="475" Canvas.Top="50" Fill="{StaticResource SuccessForegroundBrush}" />

                                                        <TextBlock Canvas.Left="8" Canvas.Top="193" FontSize="18" Foreground="#64748B" Text="0" />
                                                        <TextBlock Canvas.Left="2" Canvas.Top="120" FontSize="18" Foreground="#64748B" Text="40000" />
                                                        <TextBlock Canvas.Left="2" Canvas.Top="78" FontSize="18" Foreground="#64748B" Text="80000" />
                                                        <TextBlock Canvas.Left="0" Canvas.Top="36" FontSize="18" Foreground="#64748B" Text="120000" />
                                                        <TextBlock Canvas.Left="0" Canvas.Top="10" FontSize="18" Foreground="#64748B" Text="160000" />
                                                    </Canvas>
                                                    <UniformGrid Grid.Row="1" Columns="4" Margin="42,-4,10,0">
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Goals" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Assists" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Shots" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="#64748B" Text="Passes" />
                                                    </UniformGrid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource DashboardPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DashboardSectionTitleStyle}"
                                                   Text="Recent Matches" />
                                        <Border Height="120"
                                                Margin="0,14,0,0"
                                                Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid Margin="14,8,14,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock VerticalAlignment="Center" FontSize="19" Foreground="#64748B" Text="03 Jun" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="21" Foreground="#0F172A" Text="Dynamo Kyiv vs Shakhtar" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource SuccessForegroundBrush}" Text="2 - 1" />

                                                <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="19" Foreground="#64748B" Text="01 Jun" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="21" Foreground="#0F172A" Text="Lviv FC vs Odesa" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource SuccessForegroundBrush}" Text="1 - 1" />

                                                <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="19" Foreground="#64748B" Text="30 May" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="21" Foreground="#0F172A" Text="Dnipro vs Karpaty" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource SuccessForegroundBrush}" Text="3 - 0" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Countries/Leagues" Tag="{x:Static viewModels:AppTab.CountriesLeagues}">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Button Width="120" Margin="0,0,0,8" Content="Refresh" Command="{Binding CountriesLeagues.RefreshCommand}" />
                                <TextBlock Margin="0,0,0,6"
                                           Foreground="#9CA3AF"
                                           Text="{Binding CountriesLeagues.IsLoading, StringFormat=Loading: {0}}" />
                                <TextBlock Margin="0,0,0,6"
                                           Foreground="{StaticResource DangerForegroundBrush}"
                                           Text="{Binding CountriesLeagues.ErrorMessage}" />
                                <DataGrid ItemsSource="{Binding CountriesLeagues.Countries}"
                                          SelectedItem="{Binding CountriesLeagues.SelectedCountry, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80" />
                                        <DataGridTextColumn Header="Country" Binding="{Binding Name}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <DataGrid Grid.Column="1"
                                      Margin="10,0,0,0"
                                      ItemsSource="{Binding CountriesLeagues.Leagues}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80" />
                                    <DataGridTextColumn Header="League" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Country" Binding="{Binding CountryName}" Width="220" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Teams" Tag="{x:Static viewModels:AppTab.Teams}">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Margin="0,6,6,0" Text="Name:" />
                                <TextBox Width="260" Margin="0,0,8,0" Text="{Binding Teams.NameFilter, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="100" Margin="0,0,8,0" Content="Search" Command="{Binding Teams.SearchCommand}" />
                                <Button Width="130" Margin="0,0,8,0" Content="Open Details" Command="{Binding Teams.OpenDetailsCommand}" />
                                <Button Width="100" Margin="0,0,8,0" Content="Prev" Command="{Binding Teams.PreviousPageCommand}" />
                                <Button Width="100" Content="Next" Command="{Binding Teams.NextPageCommand}" />
                                <TextBlock Margin="12,6,0,0" Text="{Binding Teams.TotalCount, StringFormat=Total: {0}}" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Teams.Teams}"
                                      SelectedItem="{Binding Teams.SelectedTeam, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TeamApiId" Binding="{Binding TeamApiId}" Width="110" />
                                    <DataGridTextColumn Header="Long Name" Binding="{Binding LongName}" Width="*" />
                                    <DataGridTextColumn Header="Short Name" Binding="{Binding ShortName}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Team Details" Tag="{x:Static viewModels:AppTab.TeamDetails}">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Margin="0,6,6,0" Text="TeamApiId:" />
                                <TextBox Width="120" Margin="0,0,8,0" Text="{Binding TeamDetails.SelectedTeamApiId, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="100" Content="Load" Command="{Binding TeamDetails.LoadCommand}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding TeamDetails.Details.Team.LongName}" />
                                <DataGrid Margin="0,8,0,0" ItemsSource="{Binding TeamDetails.Attributes}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="130" />
                                        <DataGridTextColumn Header="Speed" Binding="{Binding BuildUpPlaySpeed}" Width="90" />
                                        <DataGridTextColumn Header="Passing" Binding="{Binding BuildUpPlayPassing}" Width="90" />
                                        <DataGridTextColumn Header="Chance" Binding="{Binding ChanceCreationPassing}" Width="90" />
                                        <DataGridTextColumn Header="Pressure" Binding="{Binding DefencePressure}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Players" Tag="{x:Static viewModels:AppTab.Players}">
                        <DockPanel Margin="8">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Margin="0,6,6,0" Text="Name:" />
                                <TextBox Width="180" Margin="0,0,8,0" Text="{Binding Players.NameFilter, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,6,0" Text="Min Overall:" />
                                <TextBox Width="70" Margin="0,0,8,0" Text="{Binding Players.MinOverall, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,6,0" Text="Min Potential:" />
                                <TextBox Width="70" Margin="0,0,8,0" Text="{Binding Players.MinPotential, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,6,0" Text="Foot:" />
                                <TextBox Width="80" Margin="0,0,8,0" Text="{Binding Players.PreferredFoot, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="100" Margin="0,0,8,0" Content="Search" Command="{Binding Players.SearchCommand}" />
                                <Button Width="130" Margin="0,0,8,0" Content="Open Details" Command="{Binding Players.OpenDetailsCommand}" />
                                <Button Width="80" Margin="0,0,8,0" Content="Prev" Command="{Binding Players.PreviousPageCommand}" />
                                <Button Width="80" Content="Next" Command="{Binding Players.NextPageCommand}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Players.Players}"
                                      SelectedItem="{Binding Players.SelectedPlayer, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PlayerApiId" Binding="{Binding PlayerApiId}" Width="100" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Overall" Binding="{Binding OverallRating}" Width="80" />
                                    <DataGridTextColumn Header="Potential" Binding="{Binding Potential}" Width="80" />
                                    <DataGridTextColumn Header="Foot" Binding="{Binding PreferredFoot}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Player Details" Tag="{x:Static viewModels:AppTab.PlayerDetails}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Margin="0,6,6,0" Text="PlayerApiId:" />
                                <TextBox Width="120" Margin="0,0,8,0" Text="{Binding PlayerDetails.SelectedPlayerApiId, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="100" Content="Load" Command="{Binding PlayerDetails.LoadCommand}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" FontSize="18" FontWeight="SemiBold" Text="{Binding PlayerDetails.Details.Name}" />
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="420" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Canvas Width="380" Height="160" Background="#0E1A2A">
                                    <Polyline Stroke="#F6C344"
                                              StrokeThickness="2"
                                              Points="{Binding PlayerDetails.TrendPoints, Converter={StaticResource TrendToPointsConverter}, ConverterParameter=overall}" />
                                    <Polyline Stroke="#44D7F6"
                                              StrokeThickness="2"
                                              Points="{Binding PlayerDetails.TrendPoints, Converter={StaticResource TrendToPointsConverter}, ConverterParameter=potential}" />
                                </Canvas>
                                <DataGrid Grid.Column="1"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding PlayerDetails.Attributes}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="130" />
                                        <DataGridTextColumn Header="Overall" Binding="{Binding OverallRating}" Width="80" />
                                        <DataGridTextColumn Header="Potential" Binding="{Binding Potential}" Width="80" />
                                        <DataGridTextColumn Header="Foot" Binding="{Binding PreferredFoot}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Matches" Tag="{x:Static viewModels:AppTab.Matches}">
                        <DockPanel Margin="8">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Width="120" Margin="0,0,8,0" Content="Load Leagues" Command="{Binding Matches.LoadLeaguesCommand}" />
                                <TextBlock Margin="0,6,6,0" Text="League:" />
                                <ComboBox Width="250"
                                          Margin="0,0,8,0"
                                          ItemsSource="{Binding Matches.Leagues}"
                                          SelectedItem="{Binding Matches.SelectedLeague, Mode=TwoWay}"
                                          DisplayMemberPath="Name" />
                                <TextBlock Margin="0,6,6,0" Text="Season:" />
                                <TextBox Width="100" Margin="0,0,8,0" Text="{Binding Matches.Season, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,6,0" Text="TeamApiId:" />
                                <TextBox Width="80" Margin="0,0,8,0" Text="{Binding Matches.TeamApiId, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="100" Margin="0,0,8,0" Content="Search" Command="{Binding Matches.SearchCommand}" />
                                <Button Width="130" Margin="0,0,8,0" Content="Open Details" Command="{Binding Matches.OpenDetailsCommand}" />
                                <Button Width="80" Margin="0,0,8,0" Content="Prev" Command="{Binding Matches.PreviousPageCommand}" />
                                <Button Width="80" Content="Next" Command="{Binding Matches.NextPageCommand}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Matches.Matches}"
                                      SelectedItem="{Binding Matches.SelectedMatch, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MatchApiId" Binding="{Binding MatchApiId}" Width="100" />
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="120" />
                                    <DataGridTextColumn Header="Season" Binding="{Binding Season}" Width="90" />
                                    <DataGridTextColumn Header="League" Binding="{Binding LeagueName}" Width="180" />
                                    <DataGridTextColumn Header="Home Team" Binding="{Binding HomeTeamName}" Width="180" />
                                    <DataGridTextColumn Header="Away Team" Binding="{Binding AwayTeamName}" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Match Details" Tag="{x:Static viewModels:AppTab.MatchDetails}">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,6,6,0" Text="MatchApiId:" />
                                <TextBox Width="120" Margin="0,0,8,0" Text="{Binding MatchDetails.SelectedMatchApiId, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="100" Content="Load" Command="{Binding MatchDetails.LoadCommand}" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding MatchDetails.Details.LeagueName}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding MatchDetails.Details.CountryName}" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding MatchDetails.Details.Season}" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding MatchDetails.Details.HomeTeamName}" />
                            <TextBlock Text="{Binding MatchDetails.Details.HomeTeamGoal, StringFormat=Goals: {0}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding MatchDetails.Details.AwayTeamName}" />
                            <TextBlock Text="{Binding MatchDetails.Details.AwayTeamGoal, StringFormat=Goals: {0}}" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Analytics" Tag="{x:Static viewModels:AppTab.Analytics}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Margin="0,6,6,0" Text="Trend PlayerApiId:" />
                                <TextBox Width="100" Margin="0,0,8,0" Text="{Binding Analytics.TrendPlayerApiId, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=LostFocus}" />
                                <Button Width="100" Margin="0,0,8,0" Content="Load Trend" Command="{Binding Analytics.LoadTrendCommand}" />
                                <TextBlock Margin="0,6,6,0" Text="Min Overall:" />
                                <TextBox Width="70" Margin="0,0,8,0" Text="{Binding Analytics.MinOverall, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,6,0" Text="Min Potential:" />
                                <TextBox Width="70" Margin="0,0,8,0" Text="{Binding Analytics.MinPotential, Converter={StaticResource NullableIntTextConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,6,0" Text="Foot:" />
                                <TextBox Width="80" Margin="0,0,8,0" Text="{Binding Analytics.PreferredFoot, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="120" Margin="0,0,8,0" Content="Top Players" Command="{Binding Analytics.LoadTopPlayersCommand}" />
                                <Button Width="140" Margin="0,0,8,0" Content="Matches/Season" Command="{Binding Analytics.LoadMatchesBySeasonCommand}" />
                                <Button Width="100" Content="Refresh All" Command="{Binding Analytics.RefreshAllCommand}" />
                            </WrapPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="420" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Canvas Width="380" Height="160" Background="#0E1A2A">
                                    <Polyline Stroke="#F6C344"
                                              StrokeThickness="2"
                                              Points="{Binding Analytics.TrendPoints, Converter={StaticResource TrendToPointsConverter}, ConverterParameter=overall}" />
                                    <Polyline Stroke="#44D7F6"
                                              StrokeThickness="2"
                                              Points="{Binding Analytics.TrendPoints, Converter={StaticResource TrendToPointsConverter}, ConverterParameter=potential}" />
                                </Canvas>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DataGrid ItemsSource="{Binding Analytics.TopPlayers}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PlayerApiId" Binding="{Binding PlayerApiId}" Width="100" />
                                            <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="*" />
                                            <DataGridTextColumn Header="Avg Overall" Binding="{Binding AverageOverallRating}" Width="100" />
                                            <DataGridTextColumn Header="Avg Potential" Binding="{Binding AveragePotential}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid Grid.Row="1"
                                              Margin="0,8,0,0"
                                              ItemsSource="{Binding Analytics.MatchesBySeason}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Season" Binding="{Binding Season}" Width="110" />
                                            <DataGridTextColumn Header="League" Binding="{Binding LeagueName}" Width="*" />
                                            <DataGridTextColumn Header="Matches" Binding="{Binding MatchCount}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
