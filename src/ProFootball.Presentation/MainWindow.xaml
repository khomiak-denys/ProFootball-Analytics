<Window x:Class="ProFootball.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ProFootball.Presentation.ViewModels"
        xmlns:views="clr-namespace:ProFootball.Presentation.Views"
        mc:Ignorable="d"
        Title="ProFootball MVP"
        Height="1024"
        Width="1440"
        MinHeight="1024"
        MinWidth="1440"
        Background="{DynamicResource ShellMainBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource ShellSidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="24,28,24,22">
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="ProFootball Analytics" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource SidebarSecondaryForegroundBrush}"
                                   Text="Data Analysis Platform" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Margin="16,6,16,16"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectedValuePath="Tag"
                             SelectedValue="{Binding SelectedSidebarTab, Mode=TwoWay}"
                             PreviewMouseLeftButtonUp="OnSidebarItemMouseLeftButtonUp"
                             ItemContainerStyle="{StaticResource SidebarNavItemStyle}">
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Dashboard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="White"
                                           Text="&#xE80F;" />
                                <TextBlock Margin="14,0,0,0"
                                           FontSize="16"
                                           Foreground="White"
                                           Text="Dashboard" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Players}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="White"
                                           Text="&#xE716;" />
                                <TextBlock Margin="14,0,0,0"
                                           FontSize="16"
                                           Foreground="White"
                                           Text="Players" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Teams}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="White"
                                           Text="&#xE72E;" />
                                <TextBlock Margin="14,0,0,0"
                                           FontSize="16"
                                           Foreground="White"
                                           Text="Teams" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Matches}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="White"
                                           Text="&#xE787;" />
                                <TextBlock Margin="14,0,0,0"
                                           FontSize="16"
                                           Foreground="White"
                                           Text="Matches" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.CountriesLeagues}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="White"
                                           Text="&#xE909;" />
                                <TextBlock Margin="14,0,0,0"
                                           FontSize="16"
                                           Foreground="White"
                                           Text="Leagues" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static viewModels:AppTab.Analytics}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="19"
                                           Foreground="White"
                                           Text="&#xE9D2;" />
                                <TextBlock Margin="14,0,0,0"
                                           FontSize="16"
                                           Foreground="White"
                                           Text="Analytics" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="2"
                            Padding="16,20"
                            BorderBrush="{DynamicResource SidebarDividerBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SidebarSecondaryForegroundBrush}"
                                   Text="{Binding Dashboard.CurrentYear, StringFormat={}© {0} ProFootball Analytics}" />
                    </Border>
                </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="22,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Text="{Binding CurrentSectionTitle}" />
                    <Border Grid.Column="1"
                            Width="430"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid Margin="14,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource ChartAxisBrush}"
                                       Text="&#xE721;" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="Search players, teams, matches..." />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Width="40"
                                Height="40"
                                Padding="0"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="Toggle theme">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Text="{Binding ThemeToggleGlyph}" />
                        </Button>
                        <Border Margin="12,0,0,0"
                                Padding="12,0"
                                Height="40"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{DynamicResource SuccessSoftBackgroundBrush}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource SuccessForegroundBrush}"
                                               Text="&#xE77B;" />
                                </Border>
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleForegroundBrush}"
                                           Text="Analyst" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,16">
                <TabControl Style="{StaticResource ContentOnlyTabControlStyle}"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding SelectedTab, Mode=TwoWay}">
                    <TabItem Header="Dashboard" Tag="{x:Static viewModels:AppTab.Dashboard}">
                        <views:DashboardView />
                    </TabItem>

                    <TabItem Header="Countries/Leagues" Tag="{x:Static viewModels:AppTab.CountriesLeagues}">
                        <views:CountriesLeaguesView />
                    </TabItem>

                    <TabItem Header="Teams" Tag="{x:Static viewModels:AppTab.Teams}">
                        <views:TeamsView />
                    </TabItem>

                    <TabItem Header="Team Details" Tag="{x:Static viewModels:AppTab.TeamDetails}">
                        <views:TeamDetailsView />
                    </TabItem>

                    <TabItem Header="Players" Tag="{x:Static viewModels:AppTab.Players}">
                        <views:PlayersView />
                    </TabItem>

                    <TabItem Header="Player Details" Tag="{x:Static viewModels:AppTab.PlayerDetails}">
                        <views:PlayerDetailsView />
                    </TabItem>

                    <TabItem Header="Matches" Tag="{x:Static viewModels:AppTab.Matches}">
                        <views:MatchesView />
                    </TabItem>

                    <TabItem Header="Match Details" Tag="{x:Static viewModels:AppTab.MatchDetails}">
                        <views:MatchDetailsView />
                    </TabItem>

                    <TabItem Header="Analytics" Tag="{x:Static viewModels:AppTab.Analytics}">
                        <views:AnalyticsView />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>


