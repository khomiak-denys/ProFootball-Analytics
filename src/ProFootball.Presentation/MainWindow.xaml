                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TitleForegroundBrush}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   FontSize="24"
                                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                                   Text="{Binding LeagueCount, StringFormat={}{0} leagues}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Padding="8,4"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource BadgeSurfaceBrush}"
